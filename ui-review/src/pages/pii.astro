---
// Phase 14.1 — PII redactor audit surface.
//
// Lists pii_audit_log entries (most recent first). Each entry shows the
// redacted_text + the categories the redactor detected. The lawyer
// inspects the redacted text for PII categories that should have been
// detected but weren't, and submits a kind='pii_miss' proposal.
//
// LGPD note: the redacted_text may contain PII the regex missed (that's
// the whole point of the audit — finding false negatives). Access is
// gated by the admin allowlist; Clerk session = audit trail.
import Layout from "../layouts/Layout.astro";
import {
  adminFetch,
  formatError,
  isVerbose,
  type PiiAuditListResponse,
} from "../lib/admin-api";

const verbose = isVerbose(Astro.url);
const auth = Astro.locals.auth();
const token = await auth.getToken();

const offset = parseInt(Astro.url.searchParams.get("offset") ?? "0", 10) || 0;
const limit = 50;

let data: PiiAuditListResponse | null = null;
let fetchError: string | null = null;
if (token) {
  try {
    data = await adminFetch<PiiAuditListResponse>("pii/audit", {
      token,
      query: { offset, limit },
    });
  } catch (e) {
    fetchError = formatError(e, verbose);
  }
}

const prevOffset = Math.max(0, offset - limit);
const nextOffset = offset + limit;
const hasPrev = offset > 0;
const hasNext = data ? nextOffset < data.total : false;

// Categories the lawyer can flag. Mirrors KNOWN_PII_TYPES on the
// backend. Grouped for the UI: top row = currently-detected (rarely
// flagged), bottom rows = gap categories (the targets of this audit).
const CATEGORY_GROUPS: Array<{ label: string; types: { value: string; label: string }[] }> = [
  {
    label: "Cobertas pelo redator atual",
    types: [
      { value: "cpf", label: "CPF" },
      { value: "cnpj", label: "CNPJ" },
      { value: "email", label: "Email" },
      { value: "phone", label: "Telefone" },
      { value: "cep", label: "CEP" },
      { value: "rg", label: "RG" },
    ],
  },
  {
    label: "Gaps identificados pela revisão jurídica",
    types: [
      { value: "oab", label: "OAB" },
      { value: "crm", label: "CRM" },
      { value: "processo_sei", label: "Processo SEI" },
      { value: "processo_cnj", label: "Processo CNJ" },
      { value: "eleitoral", label: "Título eleitoral" },
      { value: "nis", label: "NIS" },
      { value: "pis", label: "PIS" },
      { value: "iban", label: "IBAN" },
      { value: "credit_card", label: "Cartão de crédito" },
    ],
  },
];
---

<Layout title="Auditoria PII">
  <div class="container">
    <header class="page-header">
      <div>
        <span class="label-eyebrow">PII / 05</span>
        <h1>Auditoria do redator</h1>
        {data && (
          <p class="counter muted small mono">
            entradas <span class="counter-num">{offset + 1}</span>
            <span>–</span>
            <span class="counter-num">{Math.min(offset + limit, data.total)}</span>
            <span> de </span>
            <span class="counter-num">{data.total}</span>
          </p>
        )}
      </div>
      <div class="paginator">
        {hasPrev && (
          <a href={`/pii?offset=${prevOffset}`} class="button">← ANTERIOR</a>
        )}
        {hasNext && (
          <a href={`/pii?offset=${nextOffset}`} class="button">PRÓXIMA →</a>
        )}
      </div>
    </header>

    <p class="muted small intro">
      Cada entrada é uma query do produto onde o redator processou PII.
      O texto redactado pode <strong>ainda conter</strong> categorias que
      o regex atual não captura (OAB, processo SEI, eleitoral, …) — esse
      é exatamente o caso a flagar. <code>kind=pii_miss</code> alimenta
      tunagem das patterns em <code>rag_leis/pii.py</code>.
    </p>

    {fetchError && (
      <div class="alert alert-danger">
        <span class="alert-label">ERRO</span>
        <div class="alert-body">
          <strong>Falha ao carregar.</strong>
          <code>{fetchError}</code>
        </div>
      </div>
    )}

    {data && data.entries.length === 0 && (
      <p class="muted empty-state">
        — nenhuma entrada no audit log. PII redactor não foi executado
        ainda contra queries de produção.
      </p>
    )}

    {data && data.entries.length > 0 && (
      <div class="audit-list">
        {data.entries.map((entry) => (
          <article class="audit-card" data-audit-id={entry.id}>
            <header class="audit-card-header">
              <span class="audit-ts mono small muted">{entry.ts}</span>
              <span class="audit-id mono small muted">#{entry.id}</span>
            </header>

            <div class="audit-detected">
              <span class="label-eyebrow">DETECTADOS PELO REDATOR</span>
              {entry.pii_types_found.length === 0 ? (
                <span class="audit-none mono small muted">— nenhum —</span>
              ) : (
                <div class="audit-pills">
                  {entry.pii_types_found.map((t) => (
                    <span class="pii-pill">{t}</span>
                  ))}
                </div>
              )}
              <span class="audit-matches mono small muted">
                {entry.n_matches} match(es)
              </span>
            </div>

            <div class="audit-text-block">
              <span class="label-eyebrow">TEXTO REDACTADO</span>
              <pre class="audit-text">{entry.redacted_text}</pre>
            </div>

            <details class="flag-details">
              <summary>Flagar PII não detectada</summary>
              <form class="flag-form" data-audit-id={entry.id}>
                {CATEGORY_GROUPS.map((group) => (
                  <fieldset class="pii-fieldset">
                    <legend class="label-eyebrow">{group.label}</legend>
                    <div class="pii-checkboxes">
                      {group.types.map((t) => (
                        <label class="pii-check-label">
                          <input
                            type="checkbox"
                            class="pii-checkbox"
                            value={t.value}
                            data-audit-id={entry.id}
                          />
                          <span>{t.label}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                ))}

                <div class="field">
                  <label class="label-eyebrow">NOTAS (OPCIONAL)</label>
                  <textarea
                    class="pii-notes"
                    rows="2"
                    maxlength="4000"
                    placeholder="Ex: 'OAB 123.456/SP aparece literal no redacted_text; categoria não coberta pelo regex.'"
                  ></textarea>
                </div>

                <div class="form-actions">
                  <button type="submit" class="button button-primary">
                    ENVIAR PROPOSTA <span class="button-arrow">→</span>
                  </button>
                  <span class="flag-status muted small" aria-live="polite"></span>
                </div>
              </form>
            </details>
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>

<script>
  // Phase 14.2 — flag form submit. Capture phase + stopImmediatePropagation
  // so Astro's <ClientRouter /> doesn't swap the body (same pattern as
  // hierarchy.astro). Event-delegated on document so it survives view
  // transitions.
  document.addEventListener("submit", async (e) => {
    const target = e.target;
    if (!(target instanceof HTMLFormElement)) return;
    if (!target.classList.contains("flag-form")) return;
    e.preventDefault();
    e.stopImmediatePropagation();

    const auditId = target.dataset.auditId;
    if (!auditId) return;

    const submitBtn = target.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const statusEl = target.querySelector(".flag-status");
    if (!statusEl) return;

    const checkboxes = target.querySelectorAll(".pii-checkbox:checked");
    const missed: string[] = Array.from(checkboxes)
      .map((cb) => (cb as HTMLInputElement).value)
      .filter((v) => v.length > 0);
    if (missed.length === 0) {
      statusEl.textContent = "Marque ao menos uma categoria.";
      statusEl.setAttribute("data-state", "error");
      return;
    }

    const notesEl = target.querySelector(".pii-notes") as HTMLTextAreaElement | null;
    const notes = notesEl?.value ?? "";

    statusEl.textContent = "Enviando...";
    statusEl.setAttribute("data-state", "sending");
    if (submitBtn) submitBtn.disabled = true;

    try {
      const resp = await fetch(
        `/api/admin/pii/audit/${encodeURIComponent(auditId)}/flag`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ missed_types: missed, notes }),
        },
      );
      if (!resp.ok) {
        const text = await resp.text().catch(() => "");
        throw new Error(`HTTP ${resp.status}: ${text.slice(0, 200)}`);
      }
      const body = await resp.json();
      const proposalId = (body?.proposal?.id ?? "?").slice(0, 8);
      statusEl.textContent = `Proposta ${proposalId} enviada (${missed.length} cat).`;
      statusEl.setAttribute("data-state", "success");
      target.reset();
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      statusEl.textContent = `Falha: ${msg}`;
      statusEl.setAttribute("data-state", "error");
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  }, { capture: true });
</script>

<style>
  .intro { max-width: 75ch; margin: 0 0 1rem 0; }
  .empty-state { padding: 1.5rem 0; text-align: center; }

  .paginator { display: flex; gap: 0.6rem; }

  .audit-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }
  .audit-card {
    border: 1px solid var(--border);
    padding: 1rem 1.2rem;
    background: var(--bg-card);
  }
  .audit-card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .audit-detected {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0.5rem 0;
  }
  .audit-pills { display: flex; gap: 0.3rem; flex-wrap: wrap; }
  .pii-pill {
    padding: 0.12rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(94, 139, 135, 0.18);
    color: #5e8b87;
    border: 1px solid rgba(94, 139, 135, 0.5);
    font-family: ui-monospace, monospace;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .audit-text-block { margin-top: 0.6rem; }
  .audit-text {
    background: var(--bg-sunken);
    border-left: 2px solid var(--border);
    padding: 0.5rem 0.7rem;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0.3rem 0 0 0;
  }

  .flag-details {
    margin-top: 0.8rem;
    border-top: 1px solid var(--border);
    padding-top: 0.6rem;
  }
  .flag-details > summary {
    cursor: pointer;
    padding: 0.3rem 0;
    font-weight: 600;
    color: var(--emphasis);
    user-select: none;
    list-style: none;
  }
  .flag-details > summary::-webkit-details-marker { display: none; }
  .flag-details > summary::before { content: "▶ "; font-size: 0.7em; }
  .flag-details[open] > summary::before { content: "▼ "; }

  .flag-form {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .pii-fieldset {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    margin: 0;
  }
  .pii-fieldset legend {
    padding: 0 0.4rem;
  }
  .pii-checkboxes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 0.3rem;
  }
  .pii-check-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .flag-form textarea {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--fg);
    padding: 0.5rem 0.65rem;
    font-family: inherit;
    font-size: 0.95rem;
    border-radius: 0;
    box-sizing: border-box;
  }
  .flag-form textarea:focus {
    outline: 2px solid var(--emphasis);
    outline-offset: -2px;
  }
  .form-actions { display: flex; gap: 0.8rem; align-items: center; }
  .flag-status[data-state="sending"] { color: var(--emphasis); }
  .flag-status[data-state="success"] { color: var(--success, #2e7d32); }
  .flag-status[data-state="error"] { color: var(--danger, #c62828); }
</style>
