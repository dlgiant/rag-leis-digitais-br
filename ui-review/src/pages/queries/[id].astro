---
import Layout from "../../layouts/Layout.astro";
import { adminFetch, AdminApiError, formatError, isVerbose, type EvalQueryDetailResponse } from "../../lib/admin-api";

const verbose = isVerbose(Astro.url);
const { id } = Astro.params;
const auth = Astro.locals.auth();
const token = await auth.getToken();

let data: EvalQueryDetailResponse | null = null;
let fetchError: string | null = null;
let notFound = false;

if (token && id) {
  try {
    data = await adminFetch<EvalQueryDetailResponse>(`eval/queries/${id}`, { token });
  } catch (e) {
    if (e instanceof AdminApiError && e.status === 404) {
      notFound = true;
    } else {
      fetchError = formatError(e, verbose);
    }
  }
}

const lexmlUrn = (urn: string) => {
  if (!urn.startsWith("urn:lex:")) return null;
  const docUrn = urn.split("~")[0].split("!")[0];
  return `https://www.lexml.gov.br/urn/${encodeURI(docUrn)}`;
};
---

<Layout title={data ? `${data.query.slice(0, 50)}…` : "Query"}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/queries">
        <span class="arrow">←</span>
        <span>QUERIES</span>
      </a>
    </nav>

    {notFound && (
      <div class="not-found">
        <span class="label-eyebrow">STATUS / 404</span>
        <h1>Query não encontrada</h1>
        <p class="muted">
          ID <code>{id}</code> não existe no eval set.
          Pode ter sido editada (texto novo gera ID novo) ou removida.
        </p>
        <a href="/queries" class="button button-primary">VOLTAR <span class="button-arrow">→</span></a>
      </div>
    )}

    {fetchError && (
      <div class="alert alert-danger">
        <span class="alert-label">ERRO</span>
        <div class="alert-body">
          <strong>Falha ao carregar query.</strong>
          <code>{fetchError}</code>
          {!verbose && (
            <p class="alert-hint muted small">
              Para detalhes técnicos, adicione <code>?debug=1</code> à URL.
            </p>
          )}
        </div>
      </div>
    )}

    {data && (
      <article class="query-detail">
        <header class="detail-header">
          <span class="label-eyebrow">QUERY · ID {data.id}</span>
          <h1>{data.query}</h1>
          <div class="meta">
            {data.qtype && <span class="type-pill">{data.qtype}</span>}
            <span class="meta-divider">·</span>
            <span class="muted small mono">{data.core_urns.length} core{data.supporting_urns.length > 0 && <> + {data.supporting_urns.length} supporting</>}</span>
          </div>
          {data.notes && (
            <p class="notes">
              <span class="label-eyebrow">NOTAS DO EVAL</span>
              <span class="notes-body">{data.notes}</span>
            </p>
          )}
        </header>

        <section class="gold-chunks">
          <header class="section-header">
            <h2>Chunks gold</h2>
            <span class="muted small mono">{data.gold_chunks.length} chunk(s)</span>
          </header>

          {data.gold_chunks.length === 0 && (
            <p class="muted mono empty-state">— nenhum chunk encontrado para esses URNs —</p>
          )}

          <div class="chunk-list">
            {data.gold_chunks.map((chunk) => {
              const isCore = data!.core_urns.includes(chunk.urn);
              const href = lexmlUrn(chunk.urn);
              return (
                <div class={`chunk-card ${isCore ? "is-core" : "is-supporting"}`}>
                  <header class="chunk-header">
                    <div class="chunk-label-row">
                      <span class="chunk-label">{chunk.label || chunk.kind}</span>
                      <span class={`relevance-pill ${isCore ? "core" : "supporting"}`}>
                        {isCore ? "CORE" : "SUPPORTING"}
                      </span>
                    </div>
                    {chunk.nav && <div class="chunk-nav muted small mono">↳ {chunk.nav}</div>}
                  </header>
                  {chunk.caput && (
                    <div class="chunk-caput">
                      <span class="label-eyebrow">CAPUT</span>
                      <span class="chunk-caput-body">{chunk.caput}</span>
                    </div>
                  )}
                  <div class="chunk-text">{chunk.text}</div>
                  <footer class="chunk-footer">
                    <code class="chunk-urn mono">{chunk.urn}</code>
                    {href && (
                      <a href={href} target="_blank" rel="noopener" class="chunk-link">
                        LEXML <span class="arrow">↗</span>
                      </a>
                    )}
                  </footer>
                </div>
              );
            })}
          </div>

          {data.missing_urns.length > 0 && (
            <div class="alert alert-warning">
              <span class="alert-label alert-label-warning">AVISO</span>
              <div class="alert-body alert-body-warning">
                <strong>URNs no eval que não estão no corpus:</strong>
                <ul class="missing-list mono small">
                  {data.missing_urns.map((u) => <li>{u}</li>)}
                </ul>
                <p class="alert-hint muted small">
                  Pode indicar drift do corpus (URN renomeado por uma emenda)
                  ou erro de digitação no eval/queries.yaml.
                </p>
              </div>
            </div>
          )}
        </section>

        <section class="review-placeholder">
          <header class="section-header">
            <h2>Revisão</h2>
            <span class="label-eyebrow">FASE 11.2</span>
          </header>
          <p class="muted">
            Formulário de revisão (verdict + notes + sugestão de URN) chega
            na <strong>Fase 11.2</strong>. Por enquanto, esta tela é somente
            leitura.
          </p>
        </section>
      </article>
    )}
  </div>
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb { margin-bottom: 1.5rem; }
  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border: 1px solid transparent;
    transition: all 0.12s ease;
  }
  .breadcrumb a:hover {
    color: var(--accent);
    border-color: var(--border-strong);
    background: var(--bg-sunken);
    text-decoration: none;
  }
  .breadcrumb a:active {
    background: var(--accent);
    color: var(--bg-card);
  }
  .breadcrumb .arrow { transition: transform 0.1s ease; }
  .breadcrumb a:hover .arrow { transform: translateX(-2px); }

  /* Header */
  .detail-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .query-detail h1 {
    margin: 0.5rem 0 0.875rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .meta-divider { color: var(--border-strong); }
  .type-pill {
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    padding: 0.18rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--fg-dim);
    font-family: ui-monospace, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .notes {
    margin: 1rem 0 0;
    padding: 0.7rem 0.875rem;
    background: var(--emphasis-soft);
    border-left: 3px solid var(--emphasis);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .notes-body {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--fg);
  }

  /* Section header pattern */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--border);
  }
  .section-header h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
  }

  .empty-state {
    padding: 2rem 1rem;
    text-align: center;
    border: 1px dashed var(--border-strong);
  }

  /* Chunk list */
  .chunk-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chunk-card {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent);
    padding: 1rem 1.25rem;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .chunk-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }
  .chunk-card.is-supporting {
    border-left-color: var(--border-strong);
  }
  .chunk-card.is-supporting:hover {
    border-color: var(--border-strong);
  }
  .chunk-header { margin-bottom: 0.625rem; }
  .chunk-label-row {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .chunk-label {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--fg);
  }
  .relevance-pill {
    padding: 0.15rem 0.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, Menlo, monospace;
  }
  .relevance-pill.core {
    background: var(--accent);
    color: var(--bg-card);
  }
  .relevance-pill.supporting {
    background: var(--bg-sunken);
    color: var(--muted);
    border: 1px solid var(--border-strong);
  }
  .chunk-nav { margin-top: 0.3rem; }
  .chunk-caput {
    margin: 0.625rem 0;
    padding: 0.55rem 0.75rem;
    background: var(--bg-sunken);
    border-left: 2px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .chunk-caput-body {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--fg-dim);
  }
  .chunk-text {
    margin: 0.875rem 0;
    line-height: 1.6;
    font-size: 0.95rem;
    white-space: pre-wrap;
    color: var(--fg);
  }
  .chunk-footer {
    margin-top: 0.875rem;
    padding-top: 0.625rem;
    border-top: 1px dashed var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .chunk-urn {
    font-size: 0.72rem;
    color: var(--muted);
    word-break: break-all;
    background: transparent;
    padding: 0;
  }
  .chunk-link {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, Menlo, monospace;
    color: var(--accent);
    padding: 0.35rem 0.625rem;
    border: 1px solid var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.12s ease;
  }
  .chunk-link:hover {
    background: var(--accent);
    color: var(--bg-card);
    text-decoration: none;
  }
  .chunk-link:active {
    background: var(--emphasis);
    border-color: var(--emphasis);
  }
  .chunk-link .arrow { transition: transform 0.1s ease; }
  .chunk-link:hover .arrow { transform: translate(2px, -2px); }

  /* Alert (mission-control style) */
  .alert {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    margin: 1.5rem 0;
    border: 1px solid var(--border-strong);
  }
  .alert-label {
    padding: 0.875rem 1rem;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--bg-card);
    background: var(--danger);
    display: flex;
    align-items: center;
  }
  .alert-label-warning { background: var(--warning); }
  .alert-body {
    padding: 0.875rem 1.125rem;
    background: var(--danger-soft);
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .alert-body-warning { background: var(--warning-soft); }
  .alert-body code { word-break: break-all; background: rgba(0,0,0,0.06); }
  .alert-hint { margin: 0; }
  .missing-list {
    margin: 0.25rem 0 0;
    padding-left: 1.5rem;
  }
  .missing-list li { padding: 0.1rem 0; }

  /* Review placeholder */
  .review-placeholder {
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px dashed var(--border-strong);
  }
  .review-placeholder p {
    margin: 0;
    line-height: 1.55;
    font-size: 0.9rem;
  }

  /* Not found */
  .not-found {
    text-align: center;
    padding: 4rem 1rem;
    border: 1px dashed var(--border-strong);
  }
  .not-found h1 {
    margin: 0.5rem 0 0.875rem;
    font-size: 1.5rem;
  }
  .not-found p { margin: 0 0 1.5rem; }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
    text-transform: uppercase;
    border: 1px solid var(--accent);
    transition: all 0.12s ease;
    cursor: pointer;
  }
  .button-primary {
    background: var(--accent);
    color: var(--bg-card);
  }
  .button-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    text-decoration: none;
    color: var(--bg-card);
  }
  .button-primary:active {
    background: var(--emphasis);
    border-color: var(--emphasis);
    transform: translateY(1px);
  }
  .button-arrow { transition: transform 0.12s ease; }
  .button:hover .button-arrow { transform: translateX(3px); }
</style>
