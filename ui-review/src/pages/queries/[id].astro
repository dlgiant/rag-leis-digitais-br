---
import Layout from "../../layouts/Layout.astro";
import { adminFetch, AdminApiError, formatError, isVerbose, type EvalQueryDetailResponse } from "../../lib/admin-api";

const verbose = isVerbose(Astro.url);
const { id } = Astro.params;
const auth = Astro.locals.auth();
const token = await auth.getToken();

let data: EvalQueryDetailResponse | null = null;
let fetchError: string | null = null;
let notFound = false;

if (token && id) {
  try {
    data = await adminFetch<EvalQueryDetailResponse>(`eval/queries/${id}`, { token });
  } catch (e) {
    if (e instanceof AdminApiError && e.status === 404) {
      notFound = true;
    } else {
      fetchError = formatError(e, verbose);
    }
  }
}

const lexmlUrn = (urn: string) => {
  if (!urn.startsWith("urn:lex:")) return null;
  const docUrn = urn.split("~")[0].split("!")[0];
  return `https://www.lexml.gov.br/urn/${encodeURI(docUrn)}`;
};
---

<Layout title={data ? `${data.query.slice(0, 50)}… — review` : "Query — review"}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/queries">← Voltar para Queries</a>
    </nav>

    {notFound && (
      <div class="not-found">
        <h1>Query não encontrada</h1>
        <p class="muted">
          ID <code>{id}</code> não existe no eval set.
          Talvez a query foi editada (que muda o ID) ou removida.
        </p>
      </div>
    )}

    {fetchError && (
      <div class="error">
        <strong>Erro:</strong> <code>{fetchError}</code>
      </div>
    )}

    {data && (
      <article class="query-detail">
        <header>
          <h1>{data.query}</h1>
          <div class="meta">
            {data.qtype && <span class="type-pill">{data.qtype}</span>}
            <span class="muted small">ID <code>{data.id}</code></span>
          </div>
          {data.notes && (
            <p class="notes muted">
              <strong>Notas do eval:</strong> {data.notes}
            </p>
          )}
        </header>

        <section class="gold-chunks">
          <h2>
            Chunks gold
            <span class="muted small">({data.core_urns.length} core{data.supporting_urns.length > 0 && <> + {data.supporting_urns.length} supporting</>})</span>
          </h2>

          {data.gold_chunks.length === 0 && (
            <p class="muted">Nenhum chunk encontrado para esses URNs.</p>
          )}

          <div class="chunk-list">
            {data.gold_chunks.map((chunk) => {
              const isCore = data!.core_urns.includes(chunk.urn);
              const href = lexmlUrn(chunk.urn);
              return (
                <div class={`chunk-card ${isCore ? "core" : "supporting"}`}>
                  <header>
                    <div class="chunk-label">
                      {chunk.label || chunk.kind}
                      <span class={`relevance-pill ${isCore ? "core" : "supporting"}`}>
                        {isCore ? "core" : "supporting"}
                      </span>
                    </div>
                    {chunk.nav && <div class="chunk-nav muted small">{chunk.nav}</div>}
                  </header>
                  {chunk.caput && (
                    <div class="chunk-caput">
                      <span class="muted small">caput:</span> {chunk.caput}
                    </div>
                  )}
                  <div class="chunk-text">{chunk.text}</div>
                  <footer>
                    <code class="chunk-urn">{chunk.urn}</code>
                    {href && (
                      <a href={href} target="_blank" rel="noopener" class="muted small">
                        LexML →
                      </a>
                    )}
                  </footer>
                </div>
              );
            })}
          </div>

          {data.missing_urns.length > 0 && (
            <div class="missing-urns">
              <h3>URNs no eval mas não encontrados no corpus</h3>
              <ul>
                {data.missing_urns.map((u) => <li><code>{u}</code></li>)}
              </ul>
              <p class="muted small">
                Isso pode indicar drift do corpus (URN renomeado por uma emenda),
                ou um erro de digitação no <code>eval/queries.yaml</code>.
              </p>
            </div>
          )}
        </section>

        <section class="review-placeholder">
          <h2>Revisão</h2>
          <p class="muted">
            Formulário de revisão (verdict + notes + sugestão de URN) chega na
            <strong>Fase 11.2</strong>. Por enquanto, esta tela é somente leitura.
          </p>
        </section>
      </article>
    )}
  </div>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .breadcrumb a { color: var(--muted); }
  .breadcrumb a:hover { color: var(--accent); }

  .query-detail header { margin-bottom: 2rem; }
  .query-detail h1 {
    margin: 0 0 0.625rem;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .meta {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .type-pill {
    background: var(--code);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.78rem;
    color: var(--muted);
    font-family: ui-monospace, monospace;
  }
  .notes {
    margin-top: 0.875rem;
    padding: 0.625rem 0.875rem;
    background: var(--code);
    border-radius: 6px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .gold-chunks h2 {
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  .chunk-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chunk-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }
  .chunk-card.supporting {
    border-left-color: var(--muted);
    opacity: 0.92;
  }
  .chunk-card header { margin-bottom: 0.625rem; }
  .chunk-label {
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .relevance-pill {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .relevance-pill.supporting {
    background: color-mix(in srgb, var(--muted) 12%, transparent);
    color: var(--muted);
  }
  .chunk-nav { margin-top: 0.2rem; }
  .chunk-caput {
    margin: 0.5rem 0;
    padding: 0.4rem 0.625rem;
    background: var(--code);
    border-radius: 4px;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .chunk-text {
    margin: 0.75rem 0;
    line-height: 1.55;
    font-size: 0.95rem;
    white-space: pre-wrap;
  }
  .chunk-card footer {
    margin-top: 0.625rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .chunk-urn {
    font-size: 0.78rem;
    word-break: break-all;
  }

  .missing-urns {
    margin-top: 1.5rem;
    padding: 0.875rem 1rem;
    background: color-mix(in srgb, var(--warning) 8%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--warning) 30%, transparent);
    border-radius: 8px;
  }
  .missing-urns h3 {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--warning);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .missing-urns ul { margin: 0 0 0.5rem; padding-left: 1.25rem; }
  .missing-urns code { font-size: 0.85rem; }

  .review-placeholder {
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: 8px;
  }
  .review-placeholder h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .review-placeholder p { margin: 0; line-height: 1.5; }

  .not-found {
    text-align: center;
    padding: 3rem 1rem;
  }
  .not-found h1 { margin: 0 0 0.5rem; }

  .error {
    background: color-mix(in srgb, var(--danger) 8%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
    border-radius: 8px;
    padding: 0.875rem 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }
</style>
