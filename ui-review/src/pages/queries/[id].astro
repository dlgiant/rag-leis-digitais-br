---
import Layout from "../../layouts/Layout.astro";
import { adminFetch, AdminApiError, formatError, isVerbose, type EvalQueryDetailResponse } from "../../lib/admin-api";

const verbose = isVerbose(Astro.url);
const { id } = Astro.params;
const auth = Astro.locals.auth();
const token = await auth.getToken();

let data: EvalQueryDetailResponse | null = null;
let fetchError: string | null = null;
let notFound = false;

if (token && id) {
  try {
    data = await adminFetch<EvalQueryDetailResponse>(`eval/queries/${id}`, { token });
  } catch (e) {
    if (e instanceof AdminApiError && e.status === 404) {
      notFound = true;
    } else {
      fetchError = formatError(e, verbose);
    }
  }
}

const lexmlUrn = (urn: string) => {
  if (!urn.startsWith("urn:lex:")) return null;
  const docUrn = urn.split("~")[0].split("!")[0];
  return `https://www.lexml.gov.br/urn/${encodeURI(docUrn)}`;
};
---

<Layout title={data ? `${data.query.slice(0, 50)}…` : "Query"}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/queries">
        <span class="arrow">←</span>
        <span>QUERIES</span>
      </a>
    </nav>

    {notFound && (
      <div class="not-found">
        <span class="label-eyebrow">STATUS / 404</span>
        <h1>Query não encontrada</h1>
        <p class="muted">
          ID <code>{id}</code> não existe no eval set.
          Pode ter sido editada (texto novo gera ID novo) ou removida.
        </p>
        <a href="/queries" class="button button-primary">VOLTAR <span class="button-arrow">→</span></a>
      </div>
    )}

    {fetchError && (
      <div class="alert alert-danger">
        <span class="alert-label">ERRO</span>
        <div class="alert-body">
          <strong>Falha ao carregar query.</strong>
          <code>{fetchError}</code>
          {!verbose && (
            <p class="alert-hint muted small">
              Para detalhes técnicos, adicione <code>?debug=1</code> à URL.
            </p>
          )}
        </div>
      </div>
    )}

    {data && (
      <article class="query-detail">
        <header class="detail-header">
          <span class="label-eyebrow">QUERY · ID {data.id}</span>
          <h1>{data.query}</h1>
          <div class="meta">
            {data.qtype && <span class="type-pill">{data.qtype}</span>}
            <span class="meta-divider">·</span>
            <span class="muted small mono">{data.core_urns.length} core{data.supporting_urns.length > 0 && <> + {data.supporting_urns.length} supporting</>}</span>
          </div>
          {data.notes && (
            <p class="notes">
              <span class="label-eyebrow">NOTAS DO EVAL</span>
              <span class="notes-body">{data.notes}</span>
            </p>
          )}
        </header>

        <section class="gold-chunks">
          <header class="section-header">
            <h2>Chunks gold</h2>
            <span class="muted small mono">{data.gold_chunks.length} chunk(s)</span>
          </header>

          {data.gold_chunks.length === 0 && (
            <p class="muted mono empty-state">— nenhum chunk encontrado para esses URNs —</p>
          )}

          <div class="chunk-list">
            {data.gold_chunks.map((chunk) => {
              const isCore = data!.core_urns.includes(chunk.urn);
              const href = lexmlUrn(chunk.urn);
              return (
                <div class={`chunk-card ${isCore ? "is-core" : "is-supporting"}`}>
                  <header class="chunk-header">
                    <div class="chunk-label-row">
                      <span class="chunk-label">{chunk.label || chunk.kind}</span>
                      <span class={`relevance-pill ${isCore ? "core" : "supporting"}`}>
                        {isCore ? "CORE" : "SUPPORTING"}
                      </span>
                    </div>
                    {chunk.nav && <div class="chunk-nav muted small mono">↳ {chunk.nav}</div>}
                  </header>
                  {chunk.caput && (
                    <div class="chunk-caput">
                      <span class="label-eyebrow">CAPUT</span>
                      <span class="chunk-caput-body">{chunk.caput}</span>
                    </div>
                  )}
                  <div class="chunk-text">{chunk.text}</div>
                  <footer class="chunk-footer">
                    <code class="chunk-urn mono">{chunk.urn}</code>
                    {href && (
                      <a href={href} target="_blank" rel="noopener" class="chunk-link">
                        LEXML <span class="arrow">↗</span>
                      </a>
                    )}
                  </footer>
                </div>
              );
            })}
          </div>

          {data.missing_urns.length > 0 && (
            <div class="alert alert-warning">
              <span class="alert-label alert-label-warning">AVISO</span>
              <div class="alert-body alert-body-warning">
                <strong>URNs no eval que não estão no corpus:</strong>
                <ul class="missing-list mono small">
                  {data.missing_urns.map((u) => <li>{u}</li>)}
                </ul>
                <p class="alert-hint muted small">
                  Pode indicar drift do corpus (URN renomeado por uma emenda)
                  ou erro de digitação no eval/queries.yaml.
                </p>
              </div>
            </div>
          )}
        </section>

        <section class="refine-section">
          <header class="section-header">
            <h2>Refinar query</h2>
            <span class="label-eyebrow">EXPLORAR PHRASINGS · PHASE 11.3</span>
          </header>

          <p class="muted small refine-intro">
            Reescreva a query e veja quais chunks o retriever traz. URNs
            que coincidem com os <em>gold</em> são marcados em verde — útil
            para descobrir se uma alternativa de phrasing é tão boa quanto
            a original, ou para propor uma nova entrada no eval set.
          </p>

          <details class="refine-details">
            <summary>Abrir o painel de refinamento</summary>

            <form
              id="refine-form"
              class="refine-form"
              data-query-id={data.id}
            >
              <div class="field">
                <label for="refined-query" class="label-eyebrow">PHRASING ALTERNATIVO</label>
                <textarea
                  id="refined-query"
                  name="refined_query"
                  rows="3"
                  required
                  minlength="1"
                  maxlength="2000"
                  placeholder="Ex: como a LGPD define dado pessoal?"
                ></textarea>
              </div>

              <div class="refine-controls">
                <div class="field field-inline">
                  <label for="refine-top-k" class="label-eyebrow">TOP-K</label>
                  <input
                    id="refine-top-k"
                    name="top_k"
                    type="number"
                    value="10"
                    min="1"
                    max="50"
                  />
                </div>
                <label class="refine-save-checkbox">
                  <input id="refine-save" type="checkbox" name="save_as_proposal" checked />
                  <span>Salvar como proposta (kind=refinement)</span>
                </label>
              </div>

              <div class="form-actions">
                <button
                  type="submit"
                  class="button button-primary"
                  id="run-refine-btn"
                >
                  RODAR REFINE <span class="button-arrow">→</span>
                </button>
                <span id="refine-status" class="refine-status muted small" aria-live="polite"></span>
              </div>
            </form>

            <div id="refine-result" class="refine-result" hidden>
              <header class="refine-result-header">
                <span class="label-eyebrow">RESULTADO</span>
                <span id="refine-summary" class="mono small muted"></span>
              </header>
              <ol id="refine-retrieved" class="refine-retrieved"></ol>
            </div>
          </details>

          <p class="review-footnote muted small">
            Refinements <strong>não</strong> editam <code>eval/queries.yaml</code>.
            São apenas exploração; o operador decide se promove uma alternativa
            via Phase 11.4 merge tool.
          </p>
        </section>

        <section class="review-section">
          <header class="section-header">
            <h2>Revisão</h2>
            <span class="label-eyebrow">VERDICT + NOTAS</span>
          </header>

          <form
            id="review-form"
            class="review-form"
            data-query-id={data.id}
          >
            <fieldset class="verdict-fieldset">
              <legend class="label-eyebrow">VERDICT</legend>
              <div class="verdict-options">
                <label class="verdict-option">
                  <input type="radio" name="verdict" value="correct" required />
                  <span class="verdict-pill verdict-correct">Correto</span>
                  <span class="verdict-help muted small">Gold URNs apropriados; classified_type adequado.</span>
                </label>
                <label class="verdict-option">
                  <input type="radio" name="verdict" value="incorrect" />
                  <span class="verdict-pill verdict-incorrect">Incorreto</span>
                  <span class="verdict-help muted small">Gold ou classificação errados. Sugira correções abaixo.</span>
                </label>
                <label class="verdict-option">
                  <input type="radio" name="verdict" value="needs_followup" />
                  <span class="verdict-pill verdict-followup">Precisa revisão</span>
                  <span class="verdict-help muted small">Ambiguo; precisa de mais contexto ou pesquisa.</span>
                </label>
              </div>
            </fieldset>

            <div class="field">
              <label for="notes" class="label-eyebrow">NOTAS</label>
              <textarea
                id="notes"
                name="notes"
                rows="4"
                placeholder="Justifique o verdict. Cite jurisprudência ou doutrina se relevante."
                maxlength="4000"
              ></textarea>
            </div>

            <details class="optional-fields">
              <summary>Campos opcionais (sugestões de correção)</summary>
              <div class="field">
                <label for="suggested-urns" class="label-eyebrow">URNs SUGERIDOS</label>
                <textarea
                  id="suggested-urns"
                  name="suggested_gold_urns"
                  rows="3"
                  placeholder="Um URN por linha. Ex: urn:lex:br:federal:lei:2018-08-14;13709~art5;inc2"
                ></textarea>
                <p class="muted small">Preencha se o verdict for "Incorreto" e você sugere URNs alternativos.</p>
              </div>
              <div class="field">
                <label for="suggested-classified-type" class="label-eyebrow">TIPO SUGERIDO</label>
                <input
                  id="suggested-classified-type"
                  name="suggested_classified_type"
                  type="text"
                  placeholder="Ex: definicao, parafrase, citacao-literal..."
                />
              </div>
            </details>

            <div class="form-actions">
              <button
                type="submit"
                class="button button-primary"
                id="submit-review-btn"
              >
                ENVIAR PROPOSTA <span class="button-arrow">→</span>
              </button>
              <span id="review-status" class="review-status muted small" aria-live="polite"></span>
            </div>
          </form>

          <p class="review-footnote muted small">
            Propostas <strong>não</strong> editam <code>eval/queries.yaml</code> diretamente.
            O operador revisa a fila em <code>/proposals</code> e faz merge via tool CLI.
          </p>
        </section>
      </article>
    )}
  </div>
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb { margin-bottom: 1.5rem; }
  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border: 1px solid transparent;
    transition: all 0.12s ease;
  }
  .breadcrumb a:hover {
    color: var(--accent);
    border-color: var(--border-strong);
    background: var(--bg-sunken);
    text-decoration: none;
  }
  .breadcrumb a:active {
    background: var(--accent);
    color: var(--bg-card);
  }
  .breadcrumb .arrow { transition: transform 0.1s ease; }
  .breadcrumb a:hover .arrow { transform: translateX(-2px); }

  /* Header */
  .detail-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .query-detail h1 {
    margin: 0.5rem 0 0.875rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .meta-divider { color: var(--border-strong); }
  .type-pill {
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    padding: 0.18rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--fg-dim);
    font-family: ui-monospace, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .notes {
    margin: 1rem 0 0;
    padding: 0.7rem 0.875rem;
    background: var(--emphasis-soft);
    border-left: 3px solid var(--emphasis);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .notes-body {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--fg);
  }

  /* Section header pattern */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--border);
  }
  .section-header h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
  }

  .empty-state {
    padding: 2rem 1rem;
    text-align: center;
    border: 1px dashed var(--border-strong);
  }

  /* Chunk list */
  .chunk-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chunk-card {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent);
    padding: 1rem 1.25rem;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .chunk-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }
  .chunk-card.is-supporting {
    border-left-color: var(--border-strong);
  }
  .chunk-card.is-supporting:hover {
    border-color: var(--border-strong);
  }
  .chunk-header { margin-bottom: 0.625rem; }
  .chunk-label-row {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .chunk-label {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--fg);
  }
  .relevance-pill {
    padding: 0.15rem 0.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, Menlo, monospace;
  }
  .relevance-pill.core {
    background: var(--accent);
    color: var(--bg-card);
  }
  .relevance-pill.supporting {
    background: var(--bg-sunken);
    color: var(--muted);
    border: 1px solid var(--border-strong);
  }
  .chunk-nav { margin-top: 0.3rem; }
  .chunk-caput {
    margin: 0.625rem 0;
    padding: 0.55rem 0.75rem;
    background: var(--bg-sunken);
    border-left: 2px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .chunk-caput-body {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--fg-dim);
  }
  .chunk-text {
    margin: 0.875rem 0;
    line-height: 1.6;
    font-size: 0.95rem;
    white-space: pre-wrap;
    color: var(--fg);
  }
  .chunk-footer {
    margin-top: 0.875rem;
    padding-top: 0.625rem;
    border-top: 1px dashed var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .chunk-urn {
    font-size: 0.72rem;
    color: var(--muted);
    word-break: break-all;
    background: transparent;
    padding: 0;
  }
  .chunk-link {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, Menlo, monospace;
    color: var(--accent);
    padding: 0.35rem 0.625rem;
    border: 1px solid var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.12s ease;
  }
  .chunk-link:hover {
    background: var(--accent);
    color: var(--bg-card);
    text-decoration: none;
  }
  .chunk-link:active {
    background: var(--emphasis);
    border-color: var(--emphasis);
  }
  .chunk-link .arrow { transition: transform 0.1s ease; }
  .chunk-link:hover .arrow { transform: translate(2px, -2px); }

  /* Alert (mission-control style) */
  .alert {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    margin: 1.5rem 0;
    border: 1px solid var(--border-strong);
  }
  .alert-label {
    padding: 0.875rem 1rem;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--bg-card);
    background: var(--danger);
    display: flex;
    align-items: center;
  }
  .alert-label-warning { background: var(--warning); }
  .alert-body {
    padding: 0.875rem 1.125rem;
    background: var(--danger-soft);
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .alert-body-warning { background: var(--warning-soft); }
  .alert-body code { word-break: break-all; background: rgba(0,0,0,0.06); }
  .alert-hint { margin: 0; }
  .missing-list {
    margin: 0.25rem 0 0;
    padding-left: 1.5rem;
  }
  .missing-list li { padding: 0.1rem 0; }

  /* Review form (Phase 11.2) */
  .review-section {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
  }
  .review-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .verdict-fieldset {
    margin: 0;
    padding: 0;
    border: none;
  }
  .verdict-fieldset legend {
    margin: 0 0 0.5rem;
    padding: 0;
  }
  .verdict-options {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border-strong);
  }
  .verdict-option {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: var(--bg-card);
    cursor: pointer;
    transition: background 0.1s ease;
  }
  .verdict-option:hover { background: var(--bg-sunken); }
  .verdict-option:has(input:checked) {
    background: var(--accent-soft);
  }
  .verdict-option input[type="radio"] {
    accent-color: var(--accent);
    margin: 0;
  }
  .verdict-pill {
    font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border-strong);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .verdict-correct {
    color: var(--success);
    border-color: var(--success);
    background: var(--success-soft);
  }
  .verdict-incorrect {
    color: var(--danger);
    border-color: var(--danger);
    background: var(--danger-soft);
  }
  .verdict-followup {
    color: var(--warning);
    border-color: var(--warning);
    background: var(--warning-soft);
  }
  .verdict-help { line-height: 1.4; }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    /* The .label-eyebrow class is applied directly on the label */
  }
  .review-form textarea,
  .review-form input[type="text"] {
    width: 100%;
    background: var(--bg-card);
    color: var(--fg);
    border: 1px solid var(--border-strong);
    padding: 0.625rem 0.75rem;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: 1.5;
    resize: vertical;
  }
  .review-form textarea:focus,
  .review-form input[type="text"]:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .optional-fields {
    border: 1px dashed var(--border);
    padding: 0.625rem 1rem;
  }
  .optional-fields summary {
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-family: ui-monospace, Menlo, monospace;
    user-select: none;
  }
  .optional-fields[open] summary { color: var(--fg); margin-bottom: 0.75rem; }
  .optional-fields .field + .field { margin-top: 0.875rem; }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .review-status {
    line-height: 1.4;
  }
  .review-status[data-state="sending"] {
    color: var(--muted);
    font-style: italic;
  }
  .review-status[data-state="success"] {
    color: var(--success);
    font-weight: 600;
  }
  .review-status[data-state="error"] {
    color: var(--danger);
    font-weight: 600;
  }
  .review-footnote {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
    line-height: 1.55;
  }

  /* Not found */
  .not-found {
    text-align: center;
    padding: 4rem 1rem;
    border: 1px dashed var(--border-strong);
  }
  .not-found h1 {
    margin: 0.5rem 0 0.875rem;
    font-size: 1.5rem;
  }
  .not-found p { margin: 0 0 1.5rem; }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
    text-transform: uppercase;
    border: 1px solid var(--accent);
    transition: all 0.12s ease;
    cursor: pointer;
  }
  .button-primary {
    background: var(--accent);
    color: var(--bg-card);
  }
  .button-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    text-decoration: none;
    color: var(--bg-card);
  }
  .button-primary:active {
    background: var(--emphasis);
    border-color: var(--emphasis);
    transform: translateY(1px);
  }
  .button-arrow { transition: transform 0.12s ease; }
  .button:hover .button-arrow { transform: translateX(3px); }

  /* Phase 11.3 — refinement section */
  .refine-section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .refine-intro {
    margin: 0.5rem 0 1rem 0;
    max-width: 65ch;
  }
  .refine-details {
    border: 1px solid var(--border);
    background: var(--bg-sunken);
  }
  .refine-details > summary {
    cursor: pointer;
    padding: 0.6rem 1rem;
    font-weight: 600;
    user-select: none;
    list-style: none;
  }
  .refine-details > summary::-webkit-details-marker { display: none; }
  .refine-details > summary::before {
    content: "▶ ";
    color: var(--emphasis);
    font-size: 0.7em;
    margin-right: 0.4rem;
  }
  .refine-details[open] > summary::before { content: "▼ "; }
  .refine-details > summary:hover { background: var(--bg-card)); }

  .refine-form {
    padding: 1rem;
    border-top: 1px solid var(--border);
  }
  .refine-form textarea,
  .refine-form input[type="number"] {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--fg);
    padding: 0.5rem 0.65rem;
    font-family: inherit;
    font-size: 0.95rem;
    border-radius: 0;
    box-sizing: border-box;
  }
  .refine-form textarea:focus,
  .refine-form input[type="number"]:focus {
    outline: 2px solid var(--emphasis);
    outline-offset: -2px;
  }
  .refine-controls {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0.75rem 0 0.5rem 0;
    flex-wrap: wrap;
  }
  .field-inline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .field-inline input[type="number"] {
    width: 5rem;
  }
  .refine-save-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
    cursor: pointer;
  }
  .refine-status[data-state="sending"] { color: var(--emphasis); }
  .refine-status[data-state="success"] { color: var(--success, #2e7d32); }
  .refine-status[data-state="error"] { color: var(--danger, #c62828); }

  .refine-result {
    margin-top: 1rem;
    padding: 0.75rem 1rem 1rem;
    border-top: 1px solid var(--border);
  }
  .refine-result-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }
  .refine-retrieved {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .refine-retrieved-item {
    border: 1px solid var(--border);
    padding: 0.6rem 0.75rem;
    background: var(--bg-card);
  }
  .refine-retrieved-item.is-match {
    border-left: 3px solid var(--success, #2e7d32);
    background: var(--bg-card);
  }
  .refine-retrieved-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .refine-rank {
    color: var(--muted);
    font-weight: 600;
    min-width: 1.5rem;
  }
  .refine-citation {
    font-weight: 600;
    flex: 1;
  }
  .refine-score {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .refine-match-pill {
    background: var(--success, #2e7d32);
    color: #fff;
    padding: 0.1rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .refine-nav { margin: 0.2rem 0 0.3rem 0; }
  .refine-snippet {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0.35rem 0;
    color: var(--fg);
  }
  .refine-urn {
    display: block;
    word-break: break-all;
    margin-top: 0.3rem;
  }
</style>

<script>
  // Phase 11.2 — review-form submit. Event-delegated on document so
  // it survives Astro view transitions (the form element comes and
  // goes with each route swap, but document is stable).
  document.addEventListener("submit", async (e) => {
    const target = e.target;
    if (!(target instanceof HTMLFormElement)) return;
    if (target.id !== "review-form") return;
    // Capture phase + stopImmediatePropagation so Astro's <ClientRouter />
    // doesn't intercept the submit and swap the page body. See
    // hierarchy.astro for the full explanation.
    e.preventDefault();
    e.stopImmediatePropagation();

    const queryId = target.dataset.queryId;
    if (!queryId) return;

    const submitBtn = document.getElementById("submit-review-btn") as HTMLButtonElement | null;
    const statusEl = document.getElementById("review-status");
    if (!statusEl) return;

    const formData = new FormData(target);
    const verdict = formData.get("verdict");
    const notes = (formData.get("notes") ?? "").toString();
    const rawUrns = (formData.get("suggested_gold_urns") ?? "").toString();
    const suggestedClassifiedType = (formData.get("suggested_classified_type") ?? "").toString().trim() || null;

    if (typeof verdict !== "string") {
      statusEl.textContent = "Selecione um verdict.";
      statusEl.setAttribute("data-state", "error");
      return;
    }

    // Split URN textarea by lines, trim, drop blanks
    const suggestedGoldUrns = rawUrns
      .split("\n")
      .map((s) => s.trim())
      .filter((s) => s.length > 0);

    statusEl.textContent = "Enviando...";
    statusEl.setAttribute("data-state", "sending");
    if (submitBtn) submitBtn.disabled = true;

    try {
      const resp = await fetch(
        `/api/admin/eval/queries/${encodeURIComponent(queryId)}/review`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            verdict,
            notes,
            suggested_gold_urns: suggestedGoldUrns,
            suggested_classified_type: suggestedClassifiedType,
          }),
        },
      );

      if (!resp.ok) {
        const text = await resp.text().catch(() => "");
        throw new Error(`HTTP ${resp.status}: ${text.slice(0, 200)}`);
      }

      const body = await resp.json();
      const proposalId: string = body?.proposal?.id ?? "?";
      statusEl.textContent = `Proposta ${proposalId.slice(0, 8)} enviada.`;
      statusEl.setAttribute("data-state", "success");
      // Reset the form so the user knows it's been processed
      target.reset();
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      statusEl.textContent = `Falha: ${msg}`;
      statusEl.setAttribute("data-state", "error");
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  }, { capture: true });

  // Phase 11.3 — refine-form submit. Same event-delegated pattern as
  // the review form (survives Astro view transitions). Posts to
  // /api/admin/eval/queries/{id}/refine, then renders the retrieved
  // URNs with gold-match highlighting in #refine-result.
  document.addEventListener("submit", async (e) => {
    const target = e.target;
    if (!(target instanceof HTMLFormElement)) return;
    if (target.id !== "refine-form") return;
    e.preventDefault();
    e.stopImmediatePropagation();

    const queryId = target.dataset.queryId;
    if (!queryId) return;

    const runBtn = document.getElementById("run-refine-btn") as HTMLButtonElement | null;
    const statusEl = document.getElementById("refine-status");
    const resultEl = document.getElementById("refine-result");
    const retrievedList = document.getElementById("refine-retrieved");
    const summaryEl = document.getElementById("refine-summary");
    if (!statusEl || !resultEl || !retrievedList || !summaryEl) return;

    const formData = new FormData(target);
    const refinedQuery = (formData.get("refined_query") ?? "").toString().trim();
    const topK = parseInt((formData.get("top_k") ?? "10").toString(), 10) || 10;
    const saveAsProposal = formData.get("save_as_proposal") === "on";

    if (!refinedQuery) {
      statusEl.textContent = "Digite uma query.";
      statusEl.setAttribute("data-state", "error");
      return;
    }

    statusEl.textContent = "Rodando refine...";
    statusEl.setAttribute("data-state", "sending");
    if (runBtn) runBtn.disabled = true;
    resultEl.setAttribute("hidden", "");

    try {
      const resp = await fetch(
        `/api/admin/eval/queries/${encodeURIComponent(queryId)}/refine`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            refined_query: refinedQuery,
            top_k: topK,
            save_as_proposal: saveAsProposal,
          }),
        },
      );

      if (!resp.ok) {
        const text = await resp.text().catch(() => "");
        throw new Error(`HTTP ${resp.status}: ${text.slice(0, 200)}`);
      }

      const body = await resp.json();
      const refined = body.refined as {
        retrieved: Array<{
          rank: number;
          urn: string;
          score: number;
          matches_gold: boolean;
          snippet: string | null;
          citation: string | null;
          nav_text: string | null;
        }>;
        n_matches_gold: number;
        n_gold_total: number;
      };

      retrievedList.innerHTML = "";
      for (const item of refined.retrieved) {
        const li = document.createElement("li");
        li.className = `refine-retrieved-item ${item.matches_gold ? "is-match" : ""}`;
        const label = item.citation || item.urn;
        li.innerHTML = `
          <div class="refine-retrieved-header">
            <span class="refine-rank mono">${String(item.rank).padStart(2, "0")}</span>
            <span class="refine-citation">${escapeHtml(label)}</span>
            <span class="refine-score mono">${item.score.toFixed(3)}</span>
            ${item.matches_gold ? '<span class="refine-match-pill">GOLD ✓</span>' : ""}
          </div>
          ${item.nav_text ? `<div class="refine-nav muted small mono">↳ ${escapeHtml(item.nav_text)}</div>` : ""}
          ${item.snippet ? `<div class="refine-snippet">${escapeHtml(item.snippet)}</div>` : ""}
          <code class="refine-urn mono small muted">${escapeHtml(item.urn)}</code>
        `;
        retrievedList.appendChild(li);
      }
      summaryEl.textContent = `${refined.n_matches_gold}/${refined.n_gold_total} gold URNs recuperadas no top-${refined.retrieved.length}`;
      resultEl.removeAttribute("hidden");

      if (body.proposal) {
        const pid = String(body.proposal.id ?? "?").slice(0, 8);
        statusEl.textContent = `Refine concluído. Proposta ${pid} salva.`;
      } else {
        statusEl.textContent = "Refine concluído (não salvo).";
      }
      statusEl.setAttribute("data-state", "success");
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      statusEl.textContent = `Falha: ${msg}`;
      statusEl.setAttribute("data-state", "error");
    } finally {
      if (runBtn) runBtn.disabled = false;
    }
  }, { capture: true });

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
</script>
