---
import Layout from "../../layouts/Layout.astro";
import { SignIn } from "@clerk/astro/components";
---

<Layout title="Entrar — rag-leis review" hideHeader={true}>
  <section class="signin">
    <header class="signin-header">
      <h1>rag-leis<span class="muted">/review</span></h1>
      <p class="tagline muted">
        Acesso restrito. Para revisar o eval set, faça login com sua conta
        autorizada.
      </p>
    </header>

    <div class="signin-widget">
      <SignIn
        path="/sign-in"
        signUpUrl="/sign-up"
        forceRedirectUrl="/"
      />
    </div>

    <footer class="signin-footer muted small">
      <p>
        Endpoints acessados: <code>/v1/admin/*</code> em rag-leis-digitais-br.fly.dev.
        Apenas e-mails na allowlist <code>RAG_ADMIN_ALLOWLIST</code> têm acesso.
      </p>
    </footer>
  </section>

  <style>
    .signin {
      max-width: 460px;
      margin: 4rem auto 2rem;
      padding: 0 1.25rem;
    }
    .signin-header { margin-bottom: 2rem; text-align: center; }
    .signin-header h1 {
      margin: 0 0 0.5rem;
      font-size: 1.75rem;
      letter-spacing: -0.02em;
    }
    .tagline { margin: 0; font-size: 0.95rem; line-height: 1.5; }
    .signin-widget {
      display: flex;
      justify-content: center;
      margin-bottom: 2rem;
    }
    .signin-footer {
      text-align: center;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }
    .signin-footer p { margin: 0; line-height: 1.5; }
  </style>
</Layout>
