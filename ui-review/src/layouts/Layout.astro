---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  hideHeader?: boolean;
}

const { title = "Revisada", hideHeader = false } = Astro.props;
const fullTitle = title === "Revisada" ? title : `${title} — Revisada`;

// Phase 11.1 — server-rendered auth state. No Clerk-rendered
// components in the header markup; instead, read the verified
// session claims from middleware-attached Astro.locals.auth()
// and render a fully-custom avatar + menu styled by OUR CSS.
//
// This sidesteps the entire class of Clerk-CSS-injection bugs
// that hit transition:persist + ClientRouter. The Clerk JS is
// still loaded globally (window.Clerk.signOut() exists), but
// nothing Clerk-managed is on the page to inject styles.
const auth = (Astro.locals as any).auth?.();
const userId: string | null = auth?.userId ?? null;
const isAuthed = !!userId;
const claims = (auth?.sessionClaims ?? null) as {
  email?: string;
  image_url?: string;
  full_name?: string;
  first_name?: string;
  last_name?: string;
} | null;

const userEmail = claims?.email ?? "";
const userImage = claims?.image_url ?? "";
const userName =
  (claims?.full_name || claims?.first_name || userEmail.split("@")[0]) ?? "";

// Phase 11.2 — operator gate for the /proposals nav link.
// The backend uses RAG_OPERATOR_EMAIL; we mirror that env-var check
// at render time so we don't show a 403'd link to non-operators.
// Falls back to FALSE when the env var is absent.
const operatorEmail = (process.env.RAG_OPERATOR_EMAIL ?? "").trim().toLowerCase();
const isOperator = isAuthed && !!operatorEmail && userEmail.toLowerCase() === operatorEmail;

function deriveInitials(name: string, email: string): string {
  const source = name || email;
  if (!source) return "?";
  const parts = source.trim().split(/\s+/);
  if (parts.length === 1) return parts[0]!.charAt(0).toUpperCase();
  return (parts[0]!.charAt(0) + parts[parts.length - 1]!.charAt(0)).toUpperCase();
}
const initials = deriveInitials(userName, userEmail);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Revisada — painel de revisão jurídica da Aferida." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <ClientRouter />
    <script is:inline>
      // Set html[data-tooltips] before first paint so wrapped terms
      // never flicker (underlined → plain or vice-versa). Default is
      // "on" — new visitors discover the glossary; lawyers who find
      // it noisy turn it off and the choice persists.
      try {
        var saved = localStorage.getItem("revisa.tooltips");
        var on = saved === null ? true : saved === "1";
        document.documentElement.dataset.tooltips = on ? "on" : "off";
      } catch (_) {
        document.documentElement.dataset.tooltips = "on";
      }
    </script>
    <style>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 140ms;
      }
    </style>
    <style is:global>
      /* Design system: visual lineage from the Brazilian space program
         (INPE / AEB / Alcântara documentation aesthetic). Engineering-
         driven palette: navy primary, amber emphasis, warm paper bg. */
      :root {
        --bg:                 #f4f1ec;
        --bg-card:            #ffffff;
        --bg-sunken:          #ebe7df;
        --fg:                 #0a1a2e;
        --fg-dim:             #2c3a52;
        --muted:              #6a7689;
        --border:             #c5bfb5;
        --border-strong:      #8a94a8;
        --accent:             #1e3a5f;
        --accent-hover:       #14283f;
        --accent-soft:        #dde3ec;
        --emphasis:           #c47318;
        --emphasis-soft:      #f4e6d2;
        --success:            #2d5d3f;
        --success-soft:       #d6e3dc;
        --warning:            #a85410;
        --warning-soft:       #f4ddc2;
        --danger:             #8b1f1f;
        --danger-soft:        #ebd2d2;
        --code-bg:            #e8e4dc;
        --shadow-sm:          0 1px 0 rgba(10,26,46,0.06);
        --shadow-menu:        0 8px 24px rgba(10,26,46,0.16), 0 0 0 1px var(--border-strong);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg:               #0a1019;
          --bg-card:          #131a28;
          --bg-sunken:        #060a12;
          --fg:               #e8e4dc;
          --fg-dim:           #c0c8d8;
          --muted:            #7c8699;
          --border:           #2a3548;
          --border-strong:    #4a5670;
          --accent:           #6b9bd1;
          --accent-hover:     #88b3e3;
          --accent-soft:      #1a2538;
          --emphasis:         #e8a657;
          --emphasis-soft:    #3a2812;
          --success:          #7ab488;
          --success-soft:     #1a2b21;
          --warning:          #e89554;
          --warning-soft:     #3a2515;
          --danger:           #d97373;
          --danger-soft:      #321a1a;
          --code-bg:          #1c2433;
          --shadow-sm:        0 1px 0 rgba(0,0,0,0.4);
          --shadow-menu:      0 8px 24px rgba(0,0,0,0.5), 0 0 0 1px var(--border-strong);
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { font-feature-settings: "ss01", "cv02", "cv03"; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.55;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.12s ease;
      }
      a:hover { color: var(--accent-hover); text-decoration: underline; }
      a:active { color: var(--emphasis); }
      code, pre {
        font-family: ui-monospace, "JetBrains Mono", "Menlo", monospace;
        font-size: 0.875em;
      }
      code { background: var(--code-bg); padding: 0.1em 0.35em; }
      .container { max-width: 1080px; margin: 0 auto; padding: 1.75rem 1.5rem; }
      .muted { color: var(--muted); }
      .small { font-size: 0.82em; }
      .mono { font-family: ui-monospace, "JetBrains Mono", Menlo, monospace; font-variant-numeric: tabular-nums; }
      .label-eyebrow {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
      }
      input, select, textarea, button {
        font-family: inherit;
        font-size: inherit;
      }
      :where(input, select, textarea):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      ::selection { background: var(--accent); color: #ffffff; }

      /* ===== Term tooltips ==========================================
         Trigger: dotted underline on the wrapped term + soft hover
         tint. Popover: paper card matching the avatar-menu palette,
         with a typographic split (mono eyebrow term + body def), a
         3px accent stripe on the left, and a downward tail arrow.
         Animates in via translateY + opacity. Gated globally by
         html[data-tooltips="on|off"] from the header GLOSS button.
         When off, the wrapper is invisible — pure prose, no popover.
      */
      .term-tip {
        position: relative;
        display: inline;
        border-radius: 2px;
        transition: background 0.12s ease, color 0.12s ease;
      }
      .term-tip-pop {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 10px);
        transform: translateX(-50%) translateY(4px);
        width: max-content;
        max-width: 340px;
        min-width: 220px;
        display: flex;
        flex-direction: column;
        background: var(--bg-card);
        color: var(--fg);
        border: 1px solid var(--border-strong);
        border-radius: 4px;
        box-shadow:
          0 1px 2px rgba(10, 26, 46, 0.06),
          0 12px 28px rgba(10, 26, 46, 0.16);
        z-index: 200;
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.14s ease,
          transform 0.14s cubic-bezier(0.2, 0.8, 0.2, 1);
        overflow: visible;
      }
      /* 3px accent stripe on the left edge — visual anchor */
      .term-tip-pop::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 3px;
        background: var(--accent);
        border-radius: 4px 0 0 4px;
      }
      /* Downward-pointing tail (rotated square with two borders) */
      .term-tip-pop::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        width: 10px;
        height: 10px;
        margin-left: -5px;
        margin-top: -6px;
        background: var(--bg-card);
        border-right: 1px solid var(--border-strong);
        border-bottom: 1px solid var(--border-strong);
        transform: rotate(45deg);
      }
      .term-tip-pop-term {
        padding: 0.45rem 0.85rem 0.35rem 1rem;
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--bg-sunken);
        border-bottom: 1px solid var(--border);
        border-radius: 4px 4px 0 0;
      }
      .term-tip-pop-def {
        padding: 0.6rem 0.85rem 0.7rem 1rem;
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 0.8rem;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.5;
        text-transform: none;
        text-align: left;
        white-space: normal;
        color: var(--fg-dim);
      }

      /* ON state — visible underline + reveal popover on hover/focus */
      html[data-tooltips="on"] .term-tip {
        border-bottom: 1px dotted var(--accent);
        cursor: help;
        text-underline-offset: 2px;
        padding: 0 2px;
        margin: 0 -2px;
      }
      html[data-tooltips="on"] .term-tip:hover {
        background: var(--accent-soft);
      }
      html[data-tooltips="on"] .term-tip:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      html[data-tooltips="on"] .term-tip:hover > .term-tip-pop,
      html[data-tooltips="on"] .term-tip:focus-visible > .term-tip-pop,
      html[data-tooltips="on"] .term-tip:focus-within > .term-tip-pop {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      /* OFF state — wrapper invisible, popover never renders */
      html[data-tooltips="off"] .term-tip {
        border-bottom: none;
        cursor: inherit;
        background: transparent;
        padding: 0;
        margin: 0;
      }
      html[data-tooltips="off"] .term-tip-pop { display: none; }

      /* Dark mode — softer shadow so the card doesn't punch a hole */
      @media (prefers-color-scheme: dark) {
        .term-tip-pop {
          box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.4),
            0 12px 28px rgba(0, 0, 0, 0.55);
        }
      }
    </style>
  </head>
  <body>
    {!hideHeader && (
      <header class="site-header">
        <div class="site-header-inner">
          <a href="/" class="brand">
            <span class="brand-mark">Revisada</span>
          </a>
          <nav class="header-nav">
            {isAuthed ? (
              <>
                <a href="/queries" class="nav-link">QUERIES</a>
                <a href="/vigencia" class="nav-link">VIGÊNCIA</a>
                <a href="/hierarchy" class="nav-link">HIERARQUIA</a>
                <a href="/pii" class="nav-link">PII</a>
                <a href="/guia" class="nav-link">GUIA</a>
                {isOperator && <a href="/proposals" class="nav-link nav-link-operator">FILA</a>}
                <button
                  id="tooltip-toggle"
                  type="button"
                  class="tooltip-toggle"
                  aria-pressed="true"
                  aria-label="Alternar definições de termos técnicos"
                  title="Mostrar ou ocultar tooltips do glossário (termos não-jurídicos)"
                >
                  <span class="tooltip-toggle-icon" aria-hidden="true">ⓘ</span>
                  <span class="tooltip-toggle-label">GLOSS</span>
                  <span class="tooltip-toggle-state" aria-hidden="true"></span>
                </button>
                <div class="avatar-shell">
                  <button
                    id="avatar-button"
                    class="avatar-button"
                    type="button"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="avatar-menu"
                    aria-label={`Menu de ${userName}`}
                    style="height: 30px; width: 30px; border-radius: 30px;"
                  >
                    {userImage ? (
                      <img
                        src={userImage}
                        alt=""
                        class="avatar-img"
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <span class="avatar-initials">{initials}</span>
                    )}
                  </button>
                  <div
                    id="avatar-menu"
                    class="avatar-menu"
                    role="menu"
                    hidden
                  >
                    <div class="avatar-menu-header">
                      <span class="label-eyebrow">SESSÃO</span>
                      <span class="avatar-menu-name">{userName || userEmail}</span>
                      <span class="avatar-menu-email">{userEmail}</span>
                    </div>
                    <button
                      id="sign-out-btn"
                      type="button"
                      class="avatar-menu-item avatar-menu-item-destructive"
                      role="menuitem"
                    >
                      SAIR
                    </button>
                  </div>
                </div>
              </>
            ) : (
              <a href="/sign-in" class="nav-link">ENTRAR</a>
            )}
          </nav>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>

    <style>
      .site-header {
        background: var(--bg-card);
        border-bottom: 1px solid var(--border-strong);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0.75rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1rem;
        color: var(--fg);
        letter-spacing: -0.01em;
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        text-transform: uppercase;
        transition: color 0.12s ease;
      }
      .brand:hover { color: var(--accent); text-decoration: none; }
      .brand:active { color: var(--emphasis); }
      .brand-slash { color: var(--muted); font-weight: 400; }
      .header-nav {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .nav-link {
        color: var(--fg-dim);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        padding: 0.5rem 0.75rem;
        border: 1px solid transparent;
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        transition: all 0.12s ease;
      }
      .nav-link:hover {
        color: var(--fg);
        border-color: var(--border-strong);
        background: var(--bg-sunken);
        text-decoration: none;
      }
      .nav-link:active {
        background: var(--accent);
        color: var(--bg-card);
        border-color: var(--accent-hover);
      }
      .nav-link-operator {
        color: var(--emphasis);
      }
      .nav-link-operator:hover {
        color: var(--emphasis);
        border-color: var(--emphasis);
        background: var(--emphasis-soft);
      }
      .nav-link-operator:active {
        background: var(--emphasis);
        color: var(--bg-card);
        border-color: var(--emphasis);
      }

      /* ===== Glossary tooltip toggle =====
         A two-state pill that flips html[data-tooltips]. State swatch
         on the right reads ON (accent) or OFF (muted). Style mirrors
         .nav-link so it sits in the row without dominating it.        */
      .tooltip-toggle {
        appearance: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: transparent;
        border: 1px solid var(--border-strong);
        color: var(--fg-dim);
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        padding: 0.4rem 0.6rem;
        cursor: pointer;
        transition: all 0.12s ease;
      }
      .tooltip-toggle:hover {
        color: var(--fg);
        background: var(--bg-sunken);
        border-color: var(--fg-dim);
      }
      .tooltip-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .tooltip-toggle-icon {
        font-size: 0.9rem;
        line-height: 1;
      }
      .tooltip-toggle-label {
        line-height: 1;
      }
      .tooltip-toggle-state {
        display: inline-block;
        min-width: 1.6rem;
        padding: 0.1rem 0.3rem;
        text-align: center;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        line-height: 1.2;
        background: var(--bg-sunken);
        border: 1px solid var(--border);
        color: var(--muted);
      }
      .tooltip-toggle.is-on .tooltip-toggle-state {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--bg-card);
      }
      .tooltip-toggle.is-on .tooltip-toggle-state::before { content: "ON"; }
      .tooltip-toggle.is-off .tooltip-toggle-state::before { content: "OFF"; }
      /* Initial (pre-JS-sync) state — shows ON to match the default */
      .tooltip-toggle:not(.is-on):not(.is-off) .tooltip-toggle-state::before {
        content: "ON";
      }
      .tooltip-toggle.is-on .tooltip-toggle-icon { color: var(--accent); }

      /* ===== Custom avatar + menu ===== */
      .avatar-shell {
        position: relative;
      }
      .avatar-button {
        appearance: none;
        background: var(--bg-sunken);
        border: 1px solid var(--border-strong);
        padding: 0;
        margin: 0;
        width: 34px;
        height: 34px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: border-color 0.12s ease, transform 0.08s ease;
      }
      .avatar-button:hover {
        border-color: var(--accent);
      }
      .avatar-button:active {
        transform: translateY(1px);
        border-color: var(--emphasis);
      }
      .avatar-button[aria-expanded="true"] {
        border-color: var(--accent);
        background: var(--accent-soft);
      }
      .avatar-button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .avatar-initials {
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--fg);
      }

      .avatar-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        min-width: 240px;
        background: var(--bg-card);
        box-shadow: var(--shadow-menu);
        z-index: 100;
        animation: avatarMenuOpen 0.12s ease;
      }
      .avatar-menu[hidden] {
        display: none;
      }
      @keyframes avatarMenuOpen {
        from { opacity: 0; transform: translateY(-4px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .avatar-menu-header {
        padding: 0.875rem 1rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .avatar-menu-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--fg);
        line-height: 1.3;
      }
      .avatar-menu-email {
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        font-size: 0.75rem;
        color: var(--muted);
        word-break: break-all;
      }
      .avatar-menu-item {
        appearance: none;
        background: transparent;
        border: none;
        width: 100%;
        padding: 0.7rem 1rem;
        text-align: left;
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: var(--fg-dim);
        cursor: pointer;
        transition: all 0.1s ease;
      }
      .avatar-menu-item:hover {
        background: var(--bg-sunken);
        color: var(--fg);
      }
      .avatar-menu-item:active {
        background: var(--accent);
        color: var(--bg-card);
      }
      .avatar-menu-item-destructive:hover {
        background: var(--danger-soft);
        color: var(--danger);
      }
      .avatar-menu-item-destructive:active {
        background: var(--danger);
        color: var(--bg-card);
      }
    </style>

    <script>
      // Event-delegated handlers for the custom avatar menu. Bound
      // to document so they survive Astro's view-transition body
      // swaps (script runs once on initial load; document is the
      // same element across navigations).
      const closeMenu = () => {
        const btn = document.getElementById("avatar-button");
        const menu = document.getElementById("avatar-menu");
        if (menu) menu.hidden = true;
        if (btn) btn.setAttribute("aria-expanded", "false");
      };

      // localStorage is the canonical source of truth for the tooltip
      // preference. Astro's ClientRouter syncs root-element attributes
      // from the server-rendered incoming HTML on every view transition
      // — which strips html[data-tooltips] (the server doesn't render
      // it; it's a purely client-side flag). The inline <head> script
      // only runs on initial page load, so without re-applying state
      // on each navigation, the toggle silently resets.
      const readTooltipPref = () => {
        try {
          const saved = localStorage.getItem("revisa.tooltips");
          return saved === null ? true : saved === "1";
        } catch (_) {
          return true;
        }
      };
      const applyTooltipState = () => {
        const on = readTooltipPref();
        document.documentElement.dataset.tooltips = on ? "on" : "off";
        document.querySelectorAll<HTMLButtonElement>("#tooltip-toggle").forEach((b) => {
          b.setAttribute("aria-pressed", String(on));
          b.classList.toggle("is-on", on);
          b.classList.toggle("is-off", !on);
        });
        document.querySelectorAll<HTMLElement>(".term-tip").forEach((el) => {
          if (on) el.setAttribute("tabindex", "0");
          else el.removeAttribute("tabindex");
        });
      };
      // Pre-swap: bake state into the INCOMING document so the first
      // paint after view-transition already shows the right underline
      // state (no flicker between old and new attribute values).
      document.addEventListener("astro:before-swap", (e: Event) => {
        const incoming = (e as Event & { newDocument?: Document }).newDocument;
        if (incoming?.documentElement) {
          const on = readTooltipPref();
          incoming.documentElement.dataset.tooltips = on ? "on" : "off";
        }
      });
      // Initial run + post-swap rehydration (re-queries the new button
      // and term-tip nodes in the just-mounted body).
      applyTooltipState();
      document.addEventListener("astro:page-load", applyTooltipState);

      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        // Glossary toggle — flip the stored preference (localStorage is
        // the canonical state) then propagate via applyTooltipState,
        // which rewrites html dataset + button class + .term-tip tabindex.
        if (target.closest("#tooltip-toggle")) {
          const next = !readTooltipPref();
          try { localStorage.setItem("revisa.tooltips", next ? "1" : "0"); } catch (_) {}
          applyTooltipState();
          return;
        }

        // Toggle menu on avatar-button click
        if (target.closest("#avatar-button")) {
          const btn = document.getElementById("avatar-button");
          const menu = document.getElementById("avatar-menu");
          if (!btn || !menu) return;
          const open = menu.hidden;
          menu.hidden = !open;
          btn.setAttribute("aria-expanded", String(open));
          return;
        }

        // Sign out via Clerk's global JS API (no Clerk component on page)
        if (target.closest("#sign-out-btn")) {
          e.preventDefault();
          const clerk = (window as any).Clerk;
          if (clerk && typeof clerk.signOut === "function") {
            clerk.signOut({ redirectUrl: "/sign-in" });
          } else {
            // Defensive fallback: hit a server-side sign-out route if
            // Clerk JS hasn't loaded yet. (Currently unhandled — Clerk's
            // script tag is in every page's head, so this path is
            // extremely unlikely. Future-proofing.)
            window.location.href = "/sign-in";
          }
          return;
        }

        // Outside-click close
        const menu = document.getElementById("avatar-menu");
        if (
          menu &&
          !menu.hidden &&
          !target.closest("#avatar-menu") &&
          !target.closest("#avatar-button")
        ) {
          closeMenu();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMenu();
      });

      // Close the menu after a view transition lands on a new page
      // (so a user who left the menu open before clicking a link
      // doesn't see it lingering on the destination).
      document.addEventListener("astro:after-swap", closeMenu);
    </script>
  </body>
</html>
