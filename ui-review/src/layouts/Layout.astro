---
import { SignedIn, SignedOut, UserButton } from "@clerk/astro/components";

interface Props {
  title?: string;
  hideHeader?: boolean;
}

const { title = "rag-leis — review", hideHeader = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Internal review UI for rag-leis-digitais-br" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #fafaf7;
        --fg: #1a1a1a;
        --muted: #6b6b66;
        --accent: #4a5fc1;
        --accent-soft: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
        --success: #5e8b87;
        --warning: #c97a36;
        --danger: #b04a2f;
        --border: #d9d6cf;
        --bg-card: #ffffff;
        --code: #f0eee8;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1a1a;
          --fg: #e8e4dc;
          --muted: #989288;
          --accent: #8595d9;
          --accent-soft: color-mix(in srgb, var(--accent) 12%, var(--bg-card));
          --success: #84b3af;
          --warning: #d99c63;
          --danger: #d97559;
          --border: #3a3733;
          --bg-card: #232220;
          --code: #2a2925;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          "Helvetica Neue", Arial, sans-serif;
        line-height: 1.5;
        font-size: 17px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code {
        background: var(--code);
        padding: 0.1em 0.3em;
        border-radius: 3px;
        font-size: 0.9em;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .container { max-width: 960px; margin: 0 auto; padding: 1.5rem 1.25rem; }
      .muted { color: var(--muted); }
      .small { font-size: 0.85em; }
    </style>
  </head>
  <body>
    {!hideHeader && (
      <header class="site-header">
        <div class="site-header-inner">
          <a href="/" class="brand">
            rag-leis<span class="muted">/review</span>
          </a>
          <nav>
            <SignedIn>
              <a href="/queries" class="nav-link">Queries</a>
              <UserButton afterSignOutUrl="/sign-in" />
            </SignedIn>
            <SignedOut>
              <a href="/sign-in" class="nav-link">Entrar</a>
            </SignedOut>
          </nav>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    <style>
      .site-header {
        background: var(--bg-card);
        border-bottom: 1px solid var(--border);
      }
      .site-header-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 0.875rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--fg);
        letter-spacing: -0.01em;
      }
      .brand:hover {
        text-decoration: none;
        color: var(--accent);
      }
      .brand .muted { font-weight: 400; }
      nav {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .nav-link {
        color: var(--fg);
        font-size: 0.95rem;
        padding: 0.4rem 0.625rem;
        border-radius: 6px;
      }
      .nav-link:hover {
        background: var(--accent-soft);
        text-decoration: none;
      }
    </style>
  </body>
</html>
