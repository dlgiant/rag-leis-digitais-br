---
import { SignedIn, SignedOut, UserButton } from "@clerk/astro/components";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  hideHeader?: boolean;
}

const { title = "RAG-leis/revisa", hideHeader = false } = Astro.props;
const fullTitle = title === "RAG-leis/revisa" ? title : `${title} — RAG-leis/revisa`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Interface interna de revisão para RAG-leis/revisa" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    {/* Phase 11.1 — Astro 5 client-side routing. Intercepts in-app
        navigation (anchor clicks + form submits), fetches the target,
        swaps the body, and uses the View Transitions API where
        supported. Eliminates the full-page-reload white flash. The
        underlying SSR is unchanged (every route still server-renders);
        only the transition between renders becomes seamless. */}
    <ClientRouter />
    <style>
      /* View-transition tuning — soft, fast cross-fade. Default browser
         transition is 250ms which feels sluggish for an instrument-like
         UI; 140ms reads as deliberate without lag. */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 140ms;
      }
    </style>
    <style is:global>
      /* Design system: visual lineage from the Brazilian space program
         (INPE / AEB / Alcântara documentation aesthetic). Engineering-
         driven palette: navy primary, amber emphasis, warm paper bg.
         Sharp corners, tabular data, modest accents. */
      :root {
        --bg:                 #f4f1ec;
        --bg-card:            #ffffff;
        --bg-sunken:          #ebe7df;
        --fg:                 #0a1a2e;
        --fg-dim:             #2c3a52;
        --muted:              #6a7689;
        --border:             #c5bfb5;
        --border-strong:      #8a94a8;
        --accent:             #1e3a5f;
        --accent-hover:       #14283f;
        --accent-soft:        #dde3ec;
        --emphasis:           #c47318;
        --emphasis-soft:      #f4e6d2;
        --success:            #2d5d3f;
        --success-soft:       #d6e3dc;
        --warning:            #a85410;
        --warning-soft:       #f4ddc2;
        --danger:             #8b1f1f;
        --danger-soft:        #ebd2d2;
        --code-bg:            #e8e4dc;
        --shadow-sm:          0 1px 0 rgba(10,26,46,0.06);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg:               #0a1019;
          --bg-card:          #131a28;
          --bg-sunken:        #060a12;
          --fg:               #e8e4dc;
          --fg-dim:           #c0c8d8;
          --muted:            #7c8699;
          --border:           #2a3548;
          --border-strong:    #4a5670;
          --accent:           #6b9bd1;
          --accent-hover:     #88b3e3;
          --accent-soft:      #1a2538;
          --emphasis:         #e8a657;
          --emphasis-soft:    #3a2812;
          --success:          #7ab488;
          --success-soft:     #1a2b21;
          --warning:          #e89554;
          --warning-soft:     #3a2515;
          --danger:           #d97373;
          --danger-soft:      #321a1a;
          --code-bg:          #1c2433;
          --shadow-sm:        0 1px 0 rgba(0,0,0,0.4);
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { font-feature-settings: "ss01", "cv02", "cv03"; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.55;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.12s ease;
      }
      a:hover { color: var(--accent-hover); text-decoration: underline; }
      a:active { color: var(--emphasis); }
      code, pre {
        font-family: ui-monospace, "JetBrains Mono", "Menlo", monospace;
        font-size: 0.875em;
      }
      code { background: var(--code-bg); padding: 0.1em 0.35em; }
      .container { max-width: 1080px; margin: 0 auto; padding: 1.75rem 1.5rem; }
      .muted { color: var(--muted); }
      .small { font-size: 0.82em; }
      .mono { font-family: ui-monospace, "JetBrains Mono", Menlo, monospace; font-variant-numeric: tabular-nums; }
      .label-eyebrow {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
      }
      /* Form controls — sharp, technical, focus rings as outline */
      input, select, textarea, button {
        font-family: inherit;
        font-size: inherit;
      }
      :where(input, select, textarea):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      ::selection { background: var(--accent); color: #ffffff; }

      /* Phase 11.1 — Pin Clerk <UserButton /> avatar dimensions +
         circular shape. Without this, the View Transitions body swap
         + Clerk's React hydration combination occasionally lets our
         global styles win over Clerk's inline sizing on second render
         — the avatar balloons and loses its border-radius. !important
         is justified here because we're competing with Clerk's own
         component-internal stylesheet, not our own.

         The .cl-userButtonAvatarBox class is part of Clerk's stable
         "elements" surface (documented in their appearance API for
         several years; safe to target). */
      .cl-userButtonAvatarBox,
      .cl-userButtonAvatarBox > * {
        width: 32px !important;
        height: 32px !important;
        border-radius: 50% !important;
      }
      .cl-userButtonAvatarImage {
        width: 32px !important;
        height: 32px !important;
        border-radius: 50% !important;
        object-fit: cover;
      }
    </style>
  </head>
  <body>
    {!hideHeader && (
      <header class="site-header">
        <div class="site-header-inner">
          <a href="/" class="brand">
            <span class="brand-mark">RAG-leis</span><span class="brand-slash">/revisa</span>
          </a>
          <nav>
            <SignedIn>
              <a href="/queries" class="nav-link">QUERIES</a>
              <UserButton afterSignOutUrl="/sign-in" />
            </SignedIn>
            <SignedOut>
              <a href="/sign-in" class="nav-link">ENTRAR</a>
            </SignedOut>
          </nav>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    <style>
      .site-header {
        background: var(--bg-card);
        border-bottom: 1px solid var(--border-strong);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .site-header-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0.75rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1rem;
        color: var(--fg);
        letter-spacing: -0.01em;
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        text-transform: uppercase;
        transition: color 0.12s ease;
      }
      .brand:hover { color: var(--accent); text-decoration: none; }
      .brand:active { color: var(--emphasis); }
      .brand-slash {
        color: var(--muted);
        font-weight: 400;
      }
      nav {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .nav-link {
        color: var(--fg-dim);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        padding: 0.5rem 0.75rem;
        border: 1px solid transparent;
        font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
        transition: all 0.12s ease;
      }
      .nav-link:hover {
        color: var(--fg);
        border-color: var(--border-strong);
        background: var(--bg-sunken);
        text-decoration: none;
      }
      .nav-link:active {
        background: var(--accent);
        color: #ffffff;
        border-color: var(--accent-hover);
      }
    </style>
  </body>
</html>
