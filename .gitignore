__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
node_modules/
.DS_Store
.idea/
.vscode/
dist/
build/
*.egg-info/
.mypy_cache/
.ruff_cache/
# Big and/or regeneratable layers — keep out of git. We list specific
# subdirs (instead of just `data/`) so curated layers like data/vigencia
# can stay tracked.
data/raw/
# data/chunks/ — usar wildcard em vez de dir-exclusion para permitir
# re-inclusão seletiva (git não permite re-include dentro de dir excluído).
data/chunks/*
# Tier 4 jurisprudência é fonte primária (manualmente escrita; sem parser
# até Phase 6.3) — deve ser commitada.
!data/chunks/tier-4/
!data/chunks/tier-4/**
# Phase 8.5.1 — tier-1/2/3 chunks committed to git so CI runners (which
# don't have raw HTML or local builds) can deploy the production
# container. Total ~4.2MB; tractable. Local devs may regenerate via
# the corpus refresh pipeline at any time.
!data/chunks/tier-1/
!data/chunks/tier-1/**
!data/chunks/tier-2/
!data/chunks/tier-2/**
!data/chunks/tier-3/
!data/chunks/tier-3/**

# data/index/ — was fully gitignored. Phase 8.5.1: allow ONLY the
# production-config voyage index files (~30MB total) so CI deploy can
# COPY them into the Docker image. Other index variants (bge-m3,
# colbert, alternate text_modes) stay gitignored — they're eval-only.
data/index/*
!data/index/voyage-3-large__title+label+nav+caput+text.npz
!data/index/voyage-3-large__title+label+nav+caput+text.meta.json
# Phase 7.9 — LLM response cache. Per-machine, never committed (would
# bloat history + every machine's calls differ). Cache regenerates on
# demand; deleting the dir just means the next eval pays the LLM bill
# once. See rag_leis/llm_cache.py.
data/cache/

# Stdout/stderr logs from eval runs. The structured JSON per-row data
# (eval/runs/*.json) is the durable artifact; .log files duplicate
# the print_report() output and bloat history with reproducible text.
*.log
# data/metadata/ — Phase 7 (production infra): metadata jsons (~1KB each,
# ~17 docs = ~17KB total) carregam html.sha256 que é o estado durável
# do diff cycle. Sem isso, GitHub Actions runner efêmero veria todos os
# docs como NEW a cada run. Sem PII (só urn, title, lexml record, SHA).
# Files: data/metadata/<tier>/<urn>.json — tracked.
# data/audit/ — Phase 7: queremos tracked APENAS o estado de gate +
# history de mudanças. PII audit log (production telemetry com hashes
# de queries reais) DEVE seguir ignorado — usa nome distinto pra
# preservar essa fronteira (data/audit/pii_*.jsonl, etc.).
data/audit/*
!data/audit/last_eval_metrics.json
!data/audit/corpus_updates.jsonl
CLAUDE.md
STUDY-*
SUMMARY_*
SUMMARY-*
GLOSSARY.md
posts/
REVIEWER_NOTES_*.md
# Personal Claude Code tooling — agent configs are local productivity
# tooling, not project artifacts. Same convention as .vscode/ / .idea/.
# Reference REVIEWER_NOTES_*.md (also gitignored). If we ever want to
# showcase the AI tooling pattern, curate intentionally in docs/.
.claude/agents/
# OAB pilot intermediate working files — actual artifact is the curated
# eval/oab_concurso_pilot.yaml. These contain verbatim OAB text we said
# we wouldn't redistribute (study/concurso-pilot-findings.md §Methodology).
# Regen via `uv run python -m scripts.extract_oab_pilot`.
eval/oab_pilot_*_candidates.yaml

