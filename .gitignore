__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
node_modules/
.DS_Store
.idea/
.vscode/
dist/
build/
*.egg-info/
.mypy_cache/
.ruff_cache/
# Big and/or regeneratable layers — keep out of git. We list specific
# subdirs (instead of just `data/`) so curated layers like data/vigencia
# can stay tracked.
data/raw/
# data/chunks/ — usar wildcard em vez de dir-exclusion para permitir
# re-inclusão seletiva (git não permite re-include dentro de dir excluído).
data/chunks/*
# Tier 4 jurisprudência é fonte primária (manualmente escrita; sem parser
# até Phase 6.3) — deve ser commitada.
!data/chunks/tier-4/
!data/chunks/tier-4/**
data/index/
data/metadata/
# PII audit log — production telemetry; never commit (contains hashes
# of real user queries + redacted text; would defeat the LGPD purpose).
data/audit/
CLAUDE.md
STUDY-*
SUMMARY_*
SUMMARY-*
GLOSSARY.md
posts/
REVIEWER_NOTES_*.md

