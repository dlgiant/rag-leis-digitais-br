---
import Layout from "../layouts/Layout.astro";

// Phase 10b — chat page (SSR-rendered HTML; streaming logic in an
// inline-script tag that hits the same-origin proxy at /api/ask/stream).
// Phase 10c — server-side fetch of the user's conversation history;
// sidebar with grouped past threads; ?c=<uuid> loads a past
// conversation's messages inline. New /v1/ask turns return a
// conversation_id in the SSE "complete" event so we can update the URL
// and refresh the sidebar without a full reload.

const EXAMPLES = [
  "qual a definição de dado pessoal na LGPD?",
  "o que é neutralidade de rede no Marco Civil?",
  "quais são os princípios do tratamento de dados pessoais?",
  "o que diz o art. 9º do Marco Civil da Internet?",
];

// Authenticated state — middleware (src/middleware.ts) already gated;
// this is just the data fetch.
const auth = (Astro.locals as any).auth?.();
const userId: string | null = auth?.userId ?? null;
const token: string | null = userId ? await auth.getToken() : null;

const BACKEND_URL =
  process.env.RAG_BACKEND_URL || "https://rag-leis-digitais-br.fly.dev";

type ConversationRow = {
  id: string;
  title: string;
  created_at: string;
  last_message_at: string;
  message_count: number;
};

type MessageRow = {
  id: string;
  ts: string;
  role: "user" | "assistant" | "system";
  content_redacted: string;
  answer_json: any | null;
};

let conversations: ConversationRow[] = [];
const activeConvId = Astro.url.searchParams.get("c");
let activeConv: { conversation: ConversationRow; messages: MessageRow[] } | null = null;

if (token) {
  try {
    const res = await fetch(`${BACKEND_URL}/v1/conversations`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) {
      const data = await res.json();
      conversations = data.conversations ?? [];
    }
  } catch {
    /* silent degrade — sidebar stays empty if the backend hiccups */
  }

  if (activeConvId) {
    try {
      const res = await fetch(
        `${BACKEND_URL}/v1/conversations/${encodeURIComponent(activeConvId)}`,
        { headers: { Authorization: `Bearer ${token}` } },
      );
      if (res.ok) {
        activeConv = await res.json();
      }
    } catch {
      /* silent — activeConv stays null, URL param is harmless on failure */
    }
  }
}

// Per-user authed pages must NOT be cached at the Vercel edge — each
// user sees their own conversations in the sidebar.
Astro.response.headers.set("Cache-Control", "private, no-store");

// ----------- Sidebar grouping helpers (pure / server-side) -----------

function bucketLabel(isoTs: string): string {
  // Bucket conversations by activity recency. The buckets are coarse
  // by design — most users have ≤20 threads where day-precision is
  // plenty; ChatGPT-style "Last 7 days / Last 30 days" buckets would
  // be over-engineered for the data volume.
  if (!isoTs) return "Antes";
  const t = new Date(isoTs).getTime();
  if (Number.isNaN(t)) return "Antes";
  const now = Date.now();
  const dayMs = 24 * 60 * 60 * 1000;
  const diffDays = Math.floor((now - t) / dayMs);
  if (diffDays <= 0) return "Hoje";
  if (diffDays === 1) return "Ontem";
  if (diffDays < 7) return "Esta semana";
  if (diffDays < 30) return "Este mês";
  return "Antes";
}

type Bucket = { label: string; items: ConversationRow[] };
const BUCKET_ORDER = ["Hoje", "Ontem", "Esta semana", "Este mês", "Antes"];
const groupedConversations: Bucket[] = (() => {
  const map = new Map<string, ConversationRow[]>();
  for (const c of conversations) {
    const k = bucketLabel(c.last_message_at);
    if (!map.has(k)) map.set(k, []);
    map.get(k)!.push(c);
  }
  return BUCKET_ORDER
    .filter((k) => map.has(k))
    .map((k) => ({ label: k, items: map.get(k)! }));
})();

// ----------- Past-turns helpers — group messages into Q+A pairs -------

type PastTurn = {
  question: string;
  answer: string;
  citations: string[];
  refused: boolean;
  refusalReason: string | null;
};

function pairTurns(messages: MessageRow[]): PastTurn[] {
  // Messages are in chronological order (user, assistant, user, assistant…).
  // We pair them by walking the array; an unpaired trailing user message
  // is rendered with an empty answer placeholder (shouldn't happen in
  // practice since /v1/ask persists both rows in the same transaction
  // boundary, but defensive).
  const out: PastTurn[] = [];
  let i = 0;
  while (i < messages.length) {
    const m = messages[i];
    if (m.role !== "user") { i++; continue; }
    const next = messages[i + 1];
    const isAns = next && next.role === "assistant";
    const ans = isAns ? next : null;
    const aj = ans?.answer_json ?? null;
    out.push({
      question: m.content_redacted,
      answer: ans?.content_redacted ?? "",
      citations: Array.isArray(aj?.citations) ? aj.citations : [],
      refused: Boolean(aj?.refused),
      refusalReason: aj?.refusal_reason ?? null,
    });
    i += isAns ? 2 : 1;
  }
  return out;
}

const pastTurns: PastTurn[] = activeConv ? pairTurns(activeConv.messages) : [];
const activeTitle = activeConv?.conversation.title ?? "";

function lexmlHref(urn: string): string {
  const docUrn = String(urn).split("~")[0].split("!")[0];
  return `https://www.lexml.gov.br/urn/${encodeURI(docUrn)}`;
}
---

<Layout title="Aferida — pesquisa em legislação digital brasileira">
  <div class="page-wrap">
    <div class="sidebar-column">
    <aside class="sidebar" data-conv-active={activeConvId ?? ""}>
      <div class="sidebar-header">
        <a href="/" class="new-chat-btn" aria-label="Nova conversa">
          <span class="plus" aria-hidden="true">+</span>
          <span>NOVA CONVERSA</span>
        </a>
      </div>
      <nav class="sidebar-list" aria-label="Conversas anteriores">
        {conversations.length === 0 ? (
          <p class="sidebar-empty">
            Suas conversas aparecerão aqui. Cada pergunta que você faz
            inicia uma nova conversa.
          </p>
        ) : (
          groupedConversations.map((bucket) => (
            <section class="bucket">
              <h3 class="bucket-label label-eyebrow">{bucket.label}</h3>
              <ul>
                {bucket.items.map((c) => (
                  <li class={c.id === activeConvId ? "is-active" : ""}>
                    <a href={`/?c=${c.id}`} title={c.title}>
                      <span class="conv-title">{c.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )}
      </nav>
    </aside>
    </div>

    <main>
      <header class="page-header">
        <span class="label-eyebrow">
          {activeConv ? "CONVERSA / " + (pastTurns.length) : "CONSULTA / 00"}
        </span>
        <h1>
          {activeConv ? (
            <span class="active-title">{activeTitle}</span>
          ) : (
            <Fragment><span class="brand-mark">Aferida</span></Fragment>
          )}
        </h1>
        {!activeConv && (
          <>
            <p class="tagline">
              Pesquisa em legislação digital brasileira: LGPD, Marco Civil,
              Lei do Software, CDC, Constituição e correlatas. Resposta com
              citações dos artigos.
            </p>
            <ul class="privacy-chips" aria-label="Conformidade e privacidade">
              <li class="chip"><span aria-hidden="true">·</span> Hospedado no Brasil</li>
              <li class="chip"><span aria-hidden="true">·</span> PII redigida automaticamente</li>
              <li class="chip"><span aria-hidden="true">·</span> LGPD · sa-east-1</li>
            </ul>
          </>
        )}
      </header>

      {!activeConv && (
        <details class="notice" open>
          <summary>
            <span class="notice-icon" aria-hidden="true">ℹ</span>
            <span class="notice-summary-text">Sobre esta versão</span>
            <span class="notice-toggle" aria-hidden="true"></span>
          </summary>
          <div class="notice-body">
            <p>
              Esta é uma versão pública em revisão. Suas consultas são
              persistidas para histórico — você pode reabrir conversas
              anteriores na barra lateral.
            </p>
            <ul>
              <li><strong>Não envie dados pessoais reais</strong> (CPF, CNPJ, nomes de terceiros).</li>
              <li>Respostas geradas por IA — <strong>verifique cada citação</strong> antes de confiar.</li>
              <li>O serviço é hospedado no Brasil (Fly.io · São Paulo) por questões de conformidade LGPD.</li>
            </ul>
          </div>
        </details>
      )}

      {pastTurns.length > 0 && (
        <section class="past-turns" aria-label="Histórico desta conversa">
          {pastTurns.map((t, idx) => (
            <article class="past-turn">
              <header class="past-turn-q">
                <span class="label-eyebrow">PERGUNTA / {String(idx + 1).padStart(2, "0")}</span>
                <p>{t.question}</p>
              </header>
              {t.refused ? (
                <section class="past-turn-refusal">
                  <p>{t.refusalReason ?? "Não consegui responder com confiança."}</p>
                </section>
              ) : (
                <section class="past-turn-a">
                  <div class="answer-text">{t.answer}</div>
                  {t.citations.length > 0 && (
                    <section class="citations">
                      <h4>Citações</h4>
                      <ul>
                        {t.citations.map((urn) => (
                          String(urn).startsWith("urn:lex:") ? (
                            <li>
                              <a href={lexmlHref(urn)} target="_blank" rel="noopener">
                                <code>{urn}</code>
                              </a>
                              <span class="muted small"> (documento)</span>
                            </li>
                          ) : (
                            <li><code>{urn}</code></li>
                          )
                        ))}
                      </ul>
                    </section>
                  )}
                </section>
              )}
            </article>
          ))}
        </section>
      )}

      <section class="chat-input">
        <form id="askForm" data-conversation-id={activeConvId ?? ""}>
          <label for="queryInput" class="visually-hidden">Sua pergunta</label>
          <textarea
            id="queryInput"
            name="query"
            placeholder={activeConv ? "Faça uma pergunta de seguimento…" : "Faça uma pergunta sobre LGPD, Marco Civil, ou outra lei digital brasileira…"}
            rows="3"
            maxlength="2000"
            required
            autocomplete="off"
          ></textarea>
          <div class="form-row">
            <span id="charCount" class="muted small">0 / 2000</span>
            <button type="submit" id="askBtn">Perguntar</button>
          </div>
        </form>
      </section>

      <article id="result" class="result hidden" aria-live="polite">
        <header class="result-progress">
          <ol class="steps" id="steps">
            <li class="step" data-stage="classify"><span class="step-dot"></span>Classificar</li>
            <li class="step" data-stage="retrieve"><span class="step-dot"></span>Buscar</li>
            <li class="step" data-stage="generate"><span class="step-dot"></span>Gerar resposta</li>
            <li class="step" data-stage="verify"><span class="step-dot"></span>Verificar</li>
            <li class="step" data-stage="relevance_judge"><span class="step-dot"></span>Avaliar</li>
          </ol>
          <span id="elapsed" class="elapsed muted small"></span>
        </header>

        <section id="answerBody" class="result-body hidden">
          <div id="answerText" class="answer-text"></div>
          <section id="citationsSection" class="citations hidden">
            <h3>Citações</h3>
            <ul id="citationsList"></ul>
          </section>
        </section>

        <section id="refusalSection" class="result-refusal hidden">
          <p id="refusalText"></p>
        </section>

        <section id="errorSection" class="result-error hidden">
          <p id="errorText"></p>
        </section>
      </article>

      {!activeConv && (
        <details class="examples" id="examplesEl">
          <summary>Experimente uma destas perguntas</summary>
          <ul>
            {EXAMPLES.map((q) => <li><button type="button" class="example-btn" data-query={q}>{q}</button></li>)}
          </ul>
        </details>
      )}

    </main>
  </div>

  <style>
    /* ---------- Two-column layout (sidebar + main) ---------- */
    .page-wrap {
      max-width: 1180px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 1.5rem;
      padding: 1rem 1.25rem 4rem;
      align-items: start;
    }
    main {
      min-width: 0;
      max-width: 780px;
      padding: 2rem 0;
      font-size: 17px;
    }

    /* ---------- Sidebar ---------- */
    /* `.sidebar-column` is the grid item; sticky positioning lives here
       so the "Código:" link below the .sidebar box stays in view with
       the rest of the column on long pages. */
    .sidebar-column {
      position: sticky;
      top: 4rem; /* below the layout's sticky header */
      max-height: calc(100vh - 5rem);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .sidebar {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 1rem 0.75rem;
    }
    .sidebar-header {
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.75rem;
    }
.new-chat-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 0.75rem;
      width: 100%;
      background: var(--accent);
      color: #ffffff;
      font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-decoration: none;
      border: 1px solid var(--accent);
      transition: background 0.12s ease, transform 0.05s ease;
    }
    .new-chat-btn:hover {
      background: var(--accent-hover);
      color: #ffffff;
      text-decoration: none;
    }
    .new-chat-btn:active {
      background: var(--emphasis);
      transform: translateY(1px);
    }
    .new-chat-btn .plus { font-size: 1.15rem; line-height: 1; font-weight: 700; }

    .sidebar-list { display: flex; flex-direction: column; gap: 1rem; }
    .sidebar-empty {
      margin: 0;
      padding: 0.5rem;
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.5;
    }
    .bucket { display: flex; flex-direction: column; gap: 0.3rem; }
    .bucket-label {
      padding: 0 0.5rem;
      font-size: 0.65rem;
    }
    .bucket ul { list-style: none; margin: 0; padding: 0; }
    .bucket li { position: relative; }
    .bucket li a {
      display: block;
      padding: 0.45rem 0.65rem;
      font-size: 0.82rem;
      color: var(--fg-dim);
      line-height: 1.35;
      text-decoration: none;
      border-left: 2px solid transparent;
      transition: background 0.1s ease, color 0.1s ease, border-color 0.1s ease;
    }
    .bucket li a:hover {
      background: var(--bg-sunken);
      color: var(--fg);
      text-decoration: none;
    }
    .bucket li.is-active a {
      background: var(--accent-soft);
      color: var(--fg);
      border-left-color: var(--emphasis);
      font-weight: 500;
    }
    .conv-title {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* ---------- Header (mission-control brand mark) ---------- */
    .page-header {
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
    }
    .page-header .label-eyebrow {
      display: block;
      margin-bottom: 0.4rem;
    }
    h1 {
      margin: 0;
      font-size: 1.875rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.2;
      font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
      text-transform: uppercase;
    }
    .brand-mark { color: var(--fg); }
    .brand-slash { color: var(--muted); font-weight: 400; }
    .active-title {
      text-transform: none;
      font-family: inherit;
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--fg);
      letter-spacing: -0.005em;
    }
    .tagline {
      margin: 0.75rem 0 0;
      color: var(--fg-dim);
      font-size: 0.95rem;
      line-height: 1.55;
      max-width: 60ch;
    }

    /* Privacy / compliance chips — small monospace pills below the
       tagline. Subtle (no background), separator dot, hover reveals
       border. The goal is to make the LGPD posture visible without
       shouting. */
    .privacy-chips {
      list-style: none;
      padding: 0;
      margin: 0.85rem 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.6rem;
    }
    .privacy-chips .chip {
      font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--muted);
      padding: 0.18rem 0.5rem;
      border: 1px solid var(--border);
      background: var(--bg-card);
      white-space: nowrap;
    }
    .privacy-chips .chip span { color: var(--success); margin-right: 0.25rem; }

    /* ---------- Collapsible notice (only on new-conversation view) ---------- */
    .notice {
      background: color-mix(in srgb, var(--accent) 6%, var(--bg-card));
      border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
      border-radius: 0;
      margin-bottom: 1.5rem;
      overflow: hidden;
      transition: background 0.15s ease;
    }
    .notice summary {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      cursor: pointer;
      font-size: 0.95rem;
      font-weight: 500;
      list-style: none;
      user-select: none;
    }
    .notice summary::-webkit-details-marker { display: none; }
    .notice-icon {
      flex-shrink: 0;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 50%;
      background: var(--accent);
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-style: italic;
      font-weight: 700;
      font-size: 0.875rem;
    }
    .notice-summary-text { flex-grow: 1; }
    .notice-toggle {
      flex-shrink: 0;
      width: 1rem;
      height: 1rem;
      position: relative;
      transition: transform 0.15s ease;
    }
    .notice-toggle::before,
    .notice-toggle::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.75rem;
      height: 1.5px;
      background: var(--muted);
      transform: translate(-50%, -50%);
    }
    .notice-toggle::after {
      transform: translate(-50%, -50%) rotate(90deg);
      transition: transform 0.15s ease;
    }
    .notice[open] .notice-toggle::after {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    .notice-body {
      padding: 0 1rem 1rem 3.25rem;
      font-size: 0.9rem;
      line-height: 1.55;
    }
    .notice-body p { margin: 0 0 0.5rem; }
    .notice-body ul { margin: 0; padding-left: 1.25rem; }
    .notice-body li { margin-bottom: 0.25rem; }

    /* ---------- Past-turns (history rendered above the input) ---------- */
    .past-turns {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .past-turn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 1rem 1.25rem;
      box-shadow: var(--shadow-sm);
    }
    .past-turn-q {
      padding-bottom: 0.6rem;
      margin-bottom: 0.85rem;
      border-bottom: 1px solid var(--border);
    }
    .past-turn-q .label-eyebrow {
      display: block;
      margin-bottom: 0.3rem;
    }
    .past-turn-q p {
      margin: 0;
      font-size: 1.02rem;
      font-weight: 600;
      color: var(--fg);
      line-height: 1.45;
    }
    .past-turn-a .answer-text,
    .past-turn-refusal p {
      white-space: pre-wrap;
      font-size: 0.98rem;
      line-height: 1.6;
    }
    .past-turn-refusal {
      padding: 0.75rem 1rem;
      background: color-mix(in srgb, var(--muted) 8%, transparent);
      border-left: 3px solid var(--muted);
    }
    .past-turn-refusal p { color: var(--muted); margin: 0; }
    .past-turn .citations {
      margin-top: 1rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border);
    }
    .past-turn .citations h4 {
      margin: 0 0 0.4rem;
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .past-turn .citations ul { list-style: none; padding: 0; margin: 0; }
    .past-turn .citations li { padding: 0.25rem 0; font-size: 0.85rem; }

    /* ---------- Chat input ---------- */
    .chat-input { margin-bottom: 1.5rem; }
    #askForm { display: flex; flex-direction: column; gap: 0.75rem; }
    textarea {
      width: 100%;
      padding: 1rem 1.125rem;
      font-family: inherit;
      font-size: 1rem;
      line-height: 1.5;
      background: var(--bg-card);
      color: var(--fg);
      border: 1px solid var(--border);
      border-radius: 0;
      resize: vertical;
      min-height: 88px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    textarea:focus {
      outline: 2px solid var(--emphasis);
      outline-offset: -2px;
      border-color: var(--border);
      box-shadow: none;
    }
    .form-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    button {
      padding: 0.65rem 1.5rem;
      font-size: 0.85rem;
      font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
      cursor: pointer;
      border-radius: 0;
      border: 1px solid var(--accent);
      background: var(--accent);
      color: #ffffff;
      transition: background 0.12s ease, transform 0.05s ease;
    }
    button:hover:not(:disabled) {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }
    button:focus-visible:not(:disabled) {
      outline: 2px solid var(--emphasis);
      outline-offset: 1px;
    }
    button:active:not(:disabled) {
      background: var(--emphasis);
      border-color: var(--emphasis);
      transform: translateY(1px);
    }
    button:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ---------- Streaming result card ---------- */
    .result {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 0;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .result.hidden { display: none; }
    .result-progress {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1rem;
    }
    .result-progress.done-final { opacity: 0.7; }
    .steps {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.75rem;
      flex-grow: 1;
      font-size: 0.825rem;
    }
    .step {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--muted);
      transition: color 0.2s ease;
    }
    .step-dot {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--border);
      transition: background 0.2s ease, box-shadow 0.2s ease;
    }
    .step.running { color: var(--accent); font-weight: 500; }
    .step.running .step-dot {
      background: var(--accent);
      animation: pulse 1.2s ease-in-out infinite;
    }
    .step.done { color: var(--success); }
    .step.done .step-dot { background: var(--success); }
    @keyframes pulse {
      0%, 100% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent);
      }
      50% {
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 0%, transparent);
      }
    }
    .elapsed { flex-shrink: 0; font-variant-numeric: tabular-nums; }
    .result-body.hidden,
    .result-refusal.hidden,
    .result-error.hidden,
    .citations.hidden { display: none; }
    .answer-text {
      white-space: pre-wrap;
      font-size: 1rem;
      line-height: 1.6;
    }
    .citations {
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
    .citations h3 {
      margin: 0 0 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
    }
    .citations ul { list-style: none; padding: 0; margin: 0; }
    .citations li { padding: 0.3rem 0; font-size: 0.875rem; }
    .result-refusal {
      padding: 0.875rem 1rem;
      background: color-mix(in srgb, var(--muted) 8%, transparent);
      border-left: 3px solid var(--muted);
      border-radius: 0 6px 6px 0;
    }
    .result-refusal p,
    .result-error p {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }
    .result-error {
      padding: 0.875rem 1rem;
      background: color-mix(in srgb, var(--accent) 6%, transparent);
      border-left: 3px solid var(--accent);
      border-radius: 0 6px 6px 0;
    }
    .result-error p { color: var(--accent); }

    /* ---------- Examples (only on new-conversation view) ---------- */
    .examples { margin-top: 0.5rem; margin-bottom: 2rem; font-size: 0.9rem; }
    .examples summary {
      cursor: pointer;
      color: var(--muted);
      padding: 0.5rem 0;
      user-select: none;
      list-style: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .examples summary::-webkit-details-marker { display: none; }
    .examples summary::before {
      content: "+";
      display: inline-block;
      width: 1em;
      font-weight: 600;
      transition: transform 0.15s ease;
    }
    .examples[open] summary::before { content: "−"; }
    .examples ul { list-style: none; padding: 0; margin: 0.5rem 0 0; }
    .examples li { margin-bottom: 0.4rem; }
    .example-btn {
      background: var(--bg-card);
      color: var(--fg);
      border: 1px solid var(--border);
      padding: 0.55rem 0.875rem;
      font-size: 0.875rem;
      font-weight: 400;
      text-align: left;
      width: 100%;
      border-radius: 0;
    }
    .example-btn:hover:not(:disabled) {
      background: var(--code-bg);
      border-color: var(--accent);
      color: var(--fg);
    }

    /* ---------- Utility ---------- */
    .muted { color: var(--muted); }
    .small { font-size: 0.85em; }
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    /* ---------- Responsive: drop the sidebar below 900px ---------- */
    @media (max-width: 900px) {
      .page-wrap {
        grid-template-columns: 1fr;
        padding: 0.5rem 1rem 3rem;
      }
      .sidebar-column {
        position: static;
        max-height: none;
        overflow: visible;
        order: 2;
      }
      main {
        order: 1;
        padding: 1.5rem 0 0;
      }
      h1 { font-size: 1.625rem; }
      .result { padding: 1rem 1.125rem; }
      .steps { font-size: 0.75rem; }
    }
  </style>

  <script is:inline>
    // Phase 10b — vanilla JS chat client.
    // Phase 10c — sends the active conversation_id (if any) and
    // updates the URL when the backend returns a new one.

    const STAGE_ORDER = ["classify", "retrieve", "generate", "verify", "relevance_judge"];

    const form = document.getElementById("askForm");
    const queryInput = document.getElementById("queryInput");
    const askBtn = document.getElementById("askBtn");
    const charCount = document.getElementById("charCount");
    const examplesEl = document.getElementById("examplesEl");
    const result = document.getElementById("result");
    const stepsEl = document.getElementById("steps");
    const elapsedEl = document.getElementById("elapsed");
    const answerBody = document.getElementById("answerBody");
    const answerTextEl = document.getElementById("answerText");
    const citationsSectionEl = document.getElementById("citationsSection");
    const citationsListEl = document.getElementById("citationsList");
    const refusalSectionEl = document.getElementById("refusalSection");
    const refusalTextEl = document.getElementById("refusalText");
    const errorSectionEl = document.getElementById("errorSection");
    const errorTextEl = document.getElementById("errorText");
    const progressHeaderEl = result.querySelector(".result-progress");

    queryInput.addEventListener("input", () => {
      charCount.textContent = `${queryInput.value.length} / 2000`;
    });

    document.querySelectorAll(".example-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        queryInput.value = btn.dataset.query;
        charCount.textContent = `${queryInput.value.length} / 2000`;
        queryInput.focus();
        if (examplesEl) examplesEl.removeAttribute("open");
      });
    });

    function setStageState(stageName, state) {
      const li = stepsEl.querySelector(`[data-stage="${stageName}"]`);
      if (!li) return;
      li.classList.remove("running", "done");
      if (state === "running") li.classList.add("running");
      else if (state === "done") li.classList.add("done");
    }

    function resetSteps() {
      STAGE_ORDER.forEach((s) => setStageState(s, "pending"));
    }

    function renderCitation(urn) {
      const safe = String(urn).replace(/</g, "&lt;");
      const isLexml = String(urn).startsWith("urn:lex:");
      if (!isLexml) {
        return `<li><code>${safe}</code></li>`;
      }
      const docUrn = String(urn).split("~")[0].split("!")[0];
      const href = `https://www.lexml.gov.br/urn/${encodeURI(docUrn)}`;
      return `<li><a href="${href}" target="_blank" rel="noopener"><code>${safe}</code></a> <span class="muted small">(documento)</span></li>`;
    }

    function formatRefusal(reason) {
      const msgs = {
        "cosine fast-path": "A pergunta parece estar fora do escopo do corpus (leis digitais brasileiras). Tente reformular ou consulte fontes específicas para a área.",
        "llm-self-refusal": "Não encontrei informações suficientes no corpus para responder essa pergunta.",
        "empty-citations-implicit-refusal": "Não consegui ancorar a resposta em artigos do corpus, então preferi não responder.",
        "irrelevant-citations-implicit-refusal": "As fontes encontradas não respondem diretamente à pergunta. Tente reformular.",
      };
      for (const [key, msg] of Object.entries(msgs)) {
        if (reason && reason.startsWith(key)) return msg;
      }
      return reason || "Não posso responder essa pergunta com confiança.";
    }

    function clearResult() {
      result.classList.add("hidden");
      progressHeaderEl.classList.remove("done-final");
      answerBody.classList.add("hidden");
      refusalSectionEl.classList.add("hidden");
      errorSectionEl.classList.add("hidden");
      citationsSectionEl.classList.add("hidden");
      answerTextEl.textContent = "";
      citationsListEl.innerHTML = "";
      refusalTextEl.textContent = "";
      errorTextEl.textContent = "";
      elapsedEl.textContent = "";
      resetSteps();
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const query = queryInput.value.trim();
      if (!query) return;

      // The conversation_id is set as a data-attribute by the Astro page;
      // null/empty → backend will auto-create and return the new id.
      const currentConvId = form.dataset.conversationId || null;

      askBtn.disabled = true;
      askBtn.textContent = "Processando…";
      clearResult();
      result.classList.remove("hidden");
      const t0 = performance.now();
      const updateElapsed = () => {
        const s = ((performance.now() - t0) / 1000).toFixed(1);
        elapsedEl.textContent = `${s}s`;
      };
      const elapsedTimer = setInterval(updateElapsed, 100);

      try {
        const requestBody = { query };
        if (currentConvId) requestBody.conversation_id = currentConvId;

        const response = await fetch("/api/ask/stream", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(requestBody),
        });
        if (!response.ok || !response.body) {
          const err = await response.text().catch(() => "");
          throw new Error(`HTTP ${response.status}: ${err || "no body"}`);
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";
        let newConvId = null;

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });

          const frames = buffer.split("\n\n");
          buffer = frames.pop() || "";

          for (const frame of frames) {
            const line = frame.trim();
            if (!line.startsWith("data: ")) continue;
            let event;
            try {
              event = JSON.parse(line.slice(6));
            } catch {
              continue;
            }

            if (event.event === "stage") {
              const newState = event.status === "started" ? "running" : "done";
              setStageState(event.name, newState);
            } else if (event.event === "complete") {
              const ans = event.answer;
              newConvId = event.conversation_id || ans?.conversation_id || null;
              clearInterval(elapsedTimer);
              updateElapsed();
              STAGE_ORDER.forEach((s) => {
                const li = stepsEl.querySelector(`[data-stage="${s}"]`);
                if (li && !li.classList.contains("done")) li.classList.add("done");
                if (li) li.classList.remove("running");
              });
              progressHeaderEl.classList.add("done-final");

              if (ans.refused) {
                refusalSectionEl.classList.remove("hidden");
                refusalTextEl.textContent = formatRefusal(ans.refusal_reason);
              } else {
                answerBody.classList.remove("hidden");
                answerTextEl.textContent = ans.answer;
                if (ans.citations && ans.citations.length > 0) {
                  citationsSectionEl.classList.remove("hidden");
                  citationsListEl.innerHTML = ans.citations.map(renderCitation).join("");
                }
              }
            } else if (event.event === "error") {
              throw new Error(event.detail || "erro do servidor");
            }
          }
        }

        // Phase 10c — after a successful turn:
        //   * If we started without a conversation_id and got one back,
        //     replace the URL so the sidebar shows the new thread on
        //     next navigation + the URL is shareable / bookmarkable.
        //   * If we already had one, the URL is already correct; no-op.
        // We use replaceState (not pushState) so the back button doesn't
        // get cluttered with same-conversation URL updates.
        if (newConvId && !currentConvId) {
          const url = new URL(window.location.href);
          url.searchParams.set("c", newConvId);
          window.history.replaceState({}, "", url.toString());
          form.dataset.conversationId = newConvId;
          // Clear the input so a follow-up is ready to type.
          queryInput.value = "";
          charCount.textContent = "0 / 2000";
        } else if (newConvId) {
          // Already in a conversation; clear input for follow-up.
          queryInput.value = "";
          charCount.textContent = "0 / 2000";
        }
      } catch (err) {
        clearInterval(elapsedTimer);
        errorSectionEl.classList.remove("hidden");
        errorTextEl.textContent = `Erro: ${err.message}`;
        progressHeaderEl.classList.add("done-final");
      } finally {
        clearInterval(elapsedTimer);
        askBtn.disabled = false;
        askBtn.textContent = "Perguntar";
      }
    });
  </script>
</Layout>
