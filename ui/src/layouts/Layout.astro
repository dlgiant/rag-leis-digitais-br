---
// Phase 10b — minimal layout. Brazilian Portuguese. Single page, single
// chat surface. No tracking, no analytics, no third-party fonts.

interface Props {
  title?: string;
}

const { title = "rag-leis-digitais-br — demo" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Demo: RAG sobre leis digitais brasileiras (LGPD, Marco Civil, Lei do Software, etc.)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #fafaf7;
        --fg: #1a1a1a;
        --muted: #6b6b66;
        --accent: #b04a2f;
        --success: #5e8b87;
        --border: #d9d6cf;
        --bg-card: #ffffff;
        --code: #f0eee8;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1a1a;
          --fg: #e8e4dc;
          --muted: #989288;
          --accent: #d97559;
          --success: #84b3af;
          --border: #3a3733;
          --bg-card: #232220;
          --code: #2a2925;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
          "Helvetica Neue", Arial, sans-serif;
        line-height: 1.5;
        font-size: 16px;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      code {
        background: var(--code);
        padding: 0.1em 0.3em;
        border-radius: 3px;
        font-size: 0.9em;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
